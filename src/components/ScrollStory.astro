---
/** ScrollStory (Runde 29, M05): das Produkt steht still, die Geschichte zieht daran vorbei. Rechts klebt das Objekt auf seiner
 *  Fotobuehne in Bildschirmmitte, links ziehen die Schritte als Beats vorbei; welcher Beat gerade die Mitte kreuzt, bestimmt den
 *  Zustand des Objekts (motion.ts beats -> data-stage 1..n, umkehrbar, kein Scroll-Jacking). Erste Platzierung: die Bestaetigung
 *  auf /blocked-account, die den vier Schritten antwortet (DocObject story). Ohne JS, unter 1000 px, auf flachen Bildschirmen
 *  und bei reduzierter Bewegung steht das fertige Objekt (data-stage = Anzahl der Schritte) ueber der Schrittliste; die Schritte
 *  lesen sich dann wie die Schrittkarten (Section.astro), am Telefon als Zeitleiste. Texte: Buehnentexte aus ui-strings, Schritte
 *  aus den Seitendaten (lib/steps.ts, drei Sprachen). */
import PhotoStage from './PhotoStage.astro';
import DocObject from './DocObject.astro';
import BlockView from './Block.astro';
import Icon from './Icon.astro';
import { stepIcon } from '../lib/step-icons';
import { BACKDROP } from '../lib/stage-backdrops';
import type { StepItem } from '../lib/steps';
import { type Locale, t } from '../lib/i18n';
interface Props { object: 'doc'; title: string; lead: string; kicker?: string; stepsTitle?: string; steps: StepItem[]; cta?: { text: string; href: string }; locale?: Locale; id?: string; bg?: boolean }
const { object, title, lead, kicker, stepsTitle, steps, cta, locale = 'en', id = 'how-it-works', bg = true } = Astro.props;
---
<section class:list={['section', 'story', 'chapter', { 'has-bg': bg }]} id={id} data-story data-stage={String(steps.length)}>
  <div class="container">
    <div class="story-head">
      {kicker && <p class="kicker chapter-k">{kicker}</p>}
      <h2 class="chapter">{title}</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="story-grid">
      <div class="story-obj">
        <PhotoStage src={BACKDROP[object].src} pos={BACKDROP[object].pos}>
          {object === 'doc' && <DocObject stage={false} story locale={locale} vt="obj-doc" />}
        </PhotoStage>
      </div>
      <div class="beats-wrap">
        {stepsTitle && <p class="beats-title" set:html={stepsTitle} />}
        <ol class="beats">
          {steps.map((st, si) => (
            <li class="beat" data-beat>
              <span class="step-head" aria-hidden="true"><span class="num"><Icon name={stepIcon(st.titleEn)} size={18} /><i class="n" /></span><span class="step-no" /></span>
              <h3 set:html={st.title} />
              {st.paras.slice(0, 1).map((h) => <BlockView locale={locale} block={{ type: 'paragraph', html: h }} />)}
              {st.paras.length > 1 && <details class="step-more"><summary>{t(locale, 'more')}<i class="plus" aria-hidden="true" /></summary>{st.paras.slice(1).map((h) => <BlockView locale={locale} block={{ type: 'paragraph', html: h }} />)}</details>}
              {si === steps.length - 1 && cta && <p class="beat-cta"><a class="btn btn-primary" href={cta.href} data-cta-anchor>{cta.text}</a></p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
<script>
  import { beats } from '../scripts/motion';
  import { tweenText } from '../scripts/tween';
  // Nur mit Platz fuer das stehende Objekt und mit IntersectionObserver haengen die Zustaende am Scrollen; sonst bleibt das fertige
  // Objekt aus dem HTML. Betraege des Briefs laufen einmal hoch, wenn ihre Stufe erreicht ist (bei reduzierter Bewegung sofort).
  const bind = () => {
    document.querySelectorAll<HTMLElement>('.story[data-story]:not([data-beats-bound])').forEach((root) => {
      if (!(matchMedia('(min-width: 1000px) and (min-height: 700px)').matches && 'IntersectionObserver' in window)) return;
      const amounts = [...root.querySelectorAll<HTMLElement>('[data-story-amount]')];
      amounts.forEach((el) => { el.textContent = '€0.00'; });
      const done = new Set<number>();
      const apply = () => {
        const s = Number(root.dataset.stage || '0');
        if (s >= 2 && !done.has(2)) { done.add(2); const el = amounts[0]; if (el) tweenText(el, el.dataset.storyAmount ?? '', 900); }
        if (s >= 4 && !done.has(4)) { done.add(4); const el = amounts[1]; if (el) tweenText(el, el.dataset.storyAmount ?? '', 900); }
      };
      new MutationObserver(apply).observe(root, { attributes: true, attributeFilter: ['data-stage'] });
      root.dataset.stage = '0';
      beats(root);
      apply();
    });
  };
  bind(); document.addEventListener('astro:page-load', bind);
</script>
<style>
  .story { padding: var(--section-y) 0; }
  .story.has-bg { background: var(--color-surface); }
  .story-head { max-width: 760px; margin-bottom: 48px; }
  .story-head .lead { font-size: 1.25rem; max-width: 40ch; margin: 0; }
  /* Objekt rechts mit 7 von 12 Spalten und ab 1320 px ueber den Container hinaus (M03), Beats links */
  .story-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: start; }
  .story-obj { order: 2; position: sticky; top: calc(var(--hdr-sticky) + 40px); align-self: start; }
  /* 21.09.: kein Ueberhang ueber den Container (buendig mit Baendern und Karten) */
  .beats-wrap { min-width: 0; }
  .beats-title { font-size: var(--fs-small); font-weight: var(--fw-ui); letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--color-muted); margin: 0 0 8px; }
  .beats { list-style: none; margin: 0; padding: 0; counter-reset: step; }
  .beat { counter-increment: step; display: flex; flex-direction: column; justify-content: center; }
  /* Der erste Beat beginnt hoeher, der letzte endet mit seinem Inhalt (sonst bleibt unter dem Knopf eine leere Bildschirmhaelfte) */
  @media (min-width: 1000px) and (min-height: 700px) { .beat { min-height: 48vh; } .beat:first-child { min-height: 36vh; } .beat:last-child { min-height: 0; padding-top: 8vh; padding-bottom: 4vh; } }
  /* Schrittkopf wie die Schrittkarten (Section.astro, 28): Icon im Akzent-Kreis, Nummer als Etikett rechts */
  .step-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; max-width: 460px; }
  .num { width: 40px; height: 40px; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); display: grid; place-items: center; flex: none; }
  .num .n { display: none; font-style: normal; font-weight: 600; font-size: .95rem; letter-spacing: .02em; }
  .num .n::before { content: counter(step, decimal-leading-zero); }
  .step-no { font-size: .74rem; font-weight: 600; letter-spacing: var(--tracking-caps); color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .step-no::before { content: counter(step, decimal-leading-zero); }
  .beat h3 { font-size: 1.5rem; margin-bottom: .4em; max-width: 18ch; }
  .beat :global(p) { color: var(--color-muted); font-size: 1.05rem; line-height: var(--lh-lead); max-width: 46ch; margin-bottom: .7em; }
  .beat :global(p:last-child) { margin-bottom: 0; }
  .beat-cta { margin: 20px 0 0; }
  .step-more { margin-top: 6px; }
  .step-more summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: .85rem; font-weight: 600; color: var(--color-muted); padding: 4px 0; }
  .step-more summary::-webkit-details-marker { display: none; }
  .step-more .plus { position: relative; width: 14px; height: 14px; }
  .step-more .plus::before, .step-more .plus::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: currentColor; width: 10px; height: 2px; }
  .step-more .plus::after { width: 2px; height: 10px; }
  .step-more[open] .plus::after { display: none; }
  .step-more[open] > :global(p) { margin-top: 8px; }
  /* Ohne Platz zum Kleben (schmal oder flach): Ueberschrift, Objekt, dann die Schritte; nichts klebt, Zustand bleibt fertig */
  @media (max-width: 999px), (max-height: 699px) {
    .story-grid { grid-template-columns: 1fr; gap: 40px; }
    .story-obj { order: 0; position: static; margin: 0; }
    .beat { min-height: 0; padding-bottom: 36px; }
    .beat:last-child { padding-bottom: 0; }
  }
  @media (max-width: 600px) {
    .story-head { margin-bottom: 28px; }
    .story-head .lead { font-size: 1rem; }
    .story-obj { margin: 0 calc(-1 * var(--gutter)); }
    .story-obj :global(.photo-stage) { border-radius: 0; max-width: none; }
    /* Zeitleiste wie die Schrittkarten am Telefon (Section.astro): Nummer links, Linie, Text rechts */
    .beat { padding: 0 0 26px; display: grid; grid-template-columns: 36px 1fr; column-gap: 14px; position: relative; }
    .beat:last-child { padding-bottom: 0; }
    .step-head { grid-row: 1 / span 4; margin: 0; display: block; }
    .num { width: 36px; height: 36px; margin: 0; background: var(--color-surface-strong); color: var(--color-text); }
    .num :global(svg) { display: none; }
    .num .n { display: block; font-size: .88rem; }
    .step-no { display: none; }
    .beat:not(:last-child)::after { content: ""; position: absolute; inset-inline-start: 17px; top: 42px; bottom: 6px; width: 2px; background: var(--color-border); }
    .beat h3 { grid-column: 2; font-size: 1.08rem; margin: 6px 0 .35em; }
    .beat :global(p), .step-more, .beat-cta { grid-column: 2; }
    .beat :global(p) { font-size: .95rem; }
    .beat-cta { margin-top: 14px; }
    .beat-cta .btn { width: 100%; }
  }
</style>
