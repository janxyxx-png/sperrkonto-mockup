---
/** Seitenleiste des Portal-Prototyps (18-NAECHSTES-LEVEL Hebel 4): Nutzerblock, vier Screens, aktiver Eintrag nach Pfad.
 *  Seit 20.09. mit dem Demo-Umschalter (portal-demo.ts): "Before departure" / "In Germany" setzt html[data-persona] und
 *  localStorage ec-persona; alle Portal-Seiten blenden ihre Zustaende darueber um (Klassen only-applying / only-active). */
import { type Locale, localePath, t } from '../lib/i18n';
import { PORTAL } from '../lib/portal-copy';
import { PRODUCT } from '../lib/ui-strings';
import { DEMO, DEMO_DATA, PERSONA_KEY } from '../lib/portal-demo';
interface Props { locale?: Locale; current: 'dashboard' | 'transfer' | 'documents' | 'activate' }
const { locale = 'en', current } = Astro.props;
const c = (PORTAL[locale] ?? PORTAL.en).nav;
const d = DEMO[locale] ?? DEMO.en;
const items: [keyof typeof c, string][] = [['dashboard', '/app/dashboard'], ['transfer', '/app/transfer'], ['documents', '/app/documents'], ['activate', '/app/activate'], ['settings', '/app/login']];
---
<aside class="card white side">
  <div class="user">
    <div class="avatar" aria-hidden="true">{DEMO_DATA.initials}</div>
    <div class="who"><strong>{t(locale, 'dash.user')}</strong><small class="caps">{PRODUCT[locale].name}</small><small class="st only-applying"><i class="d wait"></i>{d.before}</small><small class="st only-active"><i class="d ok"></i>{d.after}</small></div>
  </div>
  <nav>{items.map(([k, href]) => <a class:list={{ active: k === current }} href={href === '#' ? '#' : localePath(locale, href)} aria-current={k === current ? 'page' : undefined}>{c[k]}</a>)}</nav>
  <div class="demo" data-persona-switch data-key={PERSONA_KEY}>
    <span class="caps dl">{d.demo}</span>
    <div class="seg seg-ctl light" role="group" aria-label={d.demo}>
      <span class="seg-thumb" aria-hidden="true"></span>
      <button type="button" data-persona-set="applying">{d.before}</button>
      <button type="button" data-persona-set="active">{d.after}</button>
    </div>
    <p class="hint">{d.demoNote}</p>
  </div>
</aside>
<script>
  // Demo-Umschalter: Zustand im Browser merken, Seite blendet sofort um; andere Skripte hoeren auf "ec-persona"
  const bind = () => {
    document.querySelectorAll<HTMLElement>('[data-persona-switch]:not([data-bound])').forEach((box) => {
      box.dataset.bound = '1'; const key = box.dataset.key || 'ec-persona';
      const mark = () => { const p = document.documentElement.dataset.persona || 'applying'; box.querySelectorAll<HTMLButtonElement>('[data-persona-set]').forEach((b) => b.classList.toggle('is-on', b.dataset.personaSet === p)); };
      /* M02: der Wechsel laeuft als View Transition (Ueberblendung der Seite), wenn der Browser sie kann und Bewegung erlaubt ist; der Rueckruf ist synchron, der Zustand steht im naechsten Frame */
      box.querySelectorAll<HTMLButtonElement>('[data-persona-set]').forEach((b) => b.addEventListener('click', () => { const p = b.dataset.personaSet!; const apply = () => { document.documentElement.dataset.persona = p; try { localStorage.setItem(key, p); } catch {} mark(); document.dispatchEvent(new CustomEvent('ec-persona', { detail: p })); }; const vt = (document as Document & { startViewTransition?: (cb: () => void) => unknown }).startViewTransition; if (vt && !matchMedia('(prefers-reduced-motion: reduce)').matches) vt.call(document, apply); else apply(); }));
      mark();
    });
  };
  bind(); document.addEventListener('astro:page-load', bind);
</script>
<style>
  .side { padding: 20px; position: sticky; top: 24px; }
  .user { display: flex; gap: 12px; align-items: center; margin-bottom: 20px; padding: 4px 8px 18px; border-bottom: 1px solid var(--color-border); }
  .who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .who small { font-size: .62rem; color: var(--color-muted); }
  .who .st { display: inline-flex; align-items: center; gap: 6px; font-size: .72rem; text-transform: none; letter-spacing: 0; margin-top: 2px; }
  .d { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .d.wait { background: var(--color-accent); } .d.ok { background: #1f7a4d; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--color-accent); color: #fff; display: grid; place-items: center; font-weight: 600; font-size: .9rem; flex: none; }
  nav a { display: block; padding: 10px 12px; border-radius: var(--radius-s); text-decoration: none; color: var(--color-muted); font-weight: 500; font-size: .93rem; transition: background-color .2s, color .2s; }
  nav a:hover { background: var(--color-surface); color: var(--color-text); }
  nav a.active { background: var(--color-surface-strong); color: var(--color-text); font-weight: 600; }
  /* Demo-Umschalter */
  .demo { margin-top: 18px; padding: 14px 12px 12px; border-top: 1px solid var(--color-border); }
  .dl { display: block; color: var(--color-muted); font-size: .62rem; margin-bottom: 8px; }
  /* Seit 27 ein Segment-Schalter mit Schieber (base.css .seg-ctl.light, motion.ts segControl); zwei gleich breite Felder */
  .seg { display: grid; grid-template-columns: 1fr 1fr; padding: 3px; gap: 2px; }
  .seg button { font-size: .76rem; font-weight: 600; padding: 7px 6px; min-height: 0; color: var(--color-muted); }
  .seg button.is-on { color: var(--color-text); }
  .hint { margin: 8px 0 0; font-size: .7rem; color: var(--color-muted); line-height: 1.4; }
  /* Telefon: die Reihe scrollt; der Verlauf am Rand zeigt es (Rundgang 20.09.) */
  @media (max-width: 900px) { .side { min-width: 0; position: static; } nav { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; min-width: 0; mask-image: linear-gradient(90deg, #000 88%, transparent); padding-inline-end: 24px; } :global([dir="rtl"]) nav { mask-image: linear-gradient(270deg, #000 88%, transparent); } nav a { white-space: nowrap; } .demo { margin-top: 12px; } }
</style>
