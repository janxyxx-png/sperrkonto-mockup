---
/** Die Bestaetigung als Objekt (14-PROMPT Aufgabe 2). Seit 18.09. spaet (Jan: "das Confirmation Letter passt visuell nicht
 *  zum Rest") nicht mehr als schraeges Papier mit Stempel und Unterschrift, sondern als Dokumentkarte in der Sprache der
 *  Seite: gerade, weiss, Radius wie die Karten, Zeilen mit Haarlinie, Status-Pill in Bordeaux, kein zweites Blatt (der
 *  Ueberstand wirkte wie ein Hubbel, Jan). Inhalt bleibt Englisch und LTR wie das echte Dokument; keine echten Nummern.
 *  M02: Referenz, Datum und Betraege kommen aus der Demo-Welt (portal-demo.ts DEMO_LETTER / DEMO_DATA), nichts steht doppelt. */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import QRCode from 'qrcode';
import { DEMO_DATA, DEMO_LETTER, demoDate, demoDateShort } from '../lib/portal-demo';
// Pruefbarer Brief (M08): QR und Link auf die Behoerdenseite mit der Referenz; das Objekt bleibt dekorativ (aria-hidden)
const verifyUrl = `${(Astro.site ?? new URL('http://localhost:4321')).href.replace(/\/$/, '')}/authorities?ref=${DEMO_LETTER.ref}`;
const qr = await QRCode.toString(verifyUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', width: 44, color: { dark: '#0b0f19', light: '#0000' } });
import { type Locale, t } from '../lib/i18n';
interface Props { class?: string; stage?: boolean; story?: boolean; locale?: Locale; vt?: string }
// vt (M13): Name fuer den Seitenwechsel (View Transition); dasselbe Objekt auf zwei Seiten reist statt zu blenden

// story (M05): der Brief antwortet den vier Schritten der ScrollStory (data-stage des umgebenden [data-story]): Entwurf, Wartend,
// Ausgestellt, Auszahlung. Die Betraege tweent das Seitenskript, deshalb ohne data-count; ohne JS steht alles fertig (Stufe 4).
const { class: cls, stage = true, story = false, locale = 'en', vt } = Astro.props;
const eur2 = (n: number) => '€' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
// Auszahlungs-Chip der Story (Stufe 4): derselbe Text wie der Chip der Bankkarte auf der Startseite (chip.bank, keine neue Zeichenkette)
const payoutChip = t(locale, 'chip.bank').split('|');
---
<div class:list={['doc-stage', cls, { stage, 'is-story': story }]} aria-hidden="true" dir="ltr" style={vt ? `view-transition-name:${vt}` : undefined}>
  <div class="stack">
    <div class="sheet">
      <div class="head"><Wordmark size=".85rem" /><span class="ref">{DEMO_LETTER.ref}</span></div>
      <div class="title">
        <span class="icircle sm"><Icon name="doc" size={18} /></span>
        <div><h3>Confirmation of Blocked Account</h3><p class="meta">Issued <span style="white-space:nowrap">{demoDate(DEMO_LETTER.issued, 'en')}</span> · {DEMO_LETTER.city}</p></div>
        {story ? <span class="pills"><span class="pill" data-s="1">Draft</span><span class="pill" data-s="2">Pending</span><span class="pill" data-s="3">Issued</span></span> : <span class="pill">Issued</span>}
      </div>
      <p class="to">{DEMO_DATA.name} · Gulshan-e-Iqbal, {DEMO_DATA.from}, Pakistan</p>
      <dl class="facts">
        <div style="--i:0"><dt>Deposit received</dt><dd data-count={story ? undefined : ''} data-story-amount={story ? eur2(DEMO_DATA.deposit) : undefined}>{eur2(DEMO_DATA.deposit)}</dd></div>
        <div style="--i:1"><dt>Monthly payout</dt><dd data-count={story ? undefined : ''} data-story-amount={story ? eur2(DEMO_DATA.payout) : undefined}>{eur2(DEMO_DATA.payout)}</dd></div>
        <div style="--i:2"><dt>Valid for</dt><dd>Visa application · 12 months</dd></div>
        <div style="--i:3"><dt>Recognised by</dt><dd>German embassies and authorities</dd></div>
      </dl>
      <div class="foot"><span class="dl" data-print><Icon name="arrow" size={14} /> Download PDF</span><span class="seal"><Icon name="check" size={12} /> Verified</span></div>
      <div class="verify"><span class="qr" set:html={qr} /><span class="vtxt"><span>Verify this letter: ecassets.com/authorities · <b>{DEMO_LETTER.ref}</b></span><span class="vok"><Icon name="check" size={11} /> Verified {demoDateShort(DEMO_LETTER.issued, 'en')} {DEMO_LETTER.issued.slice(0, 4)} · {DEMO_LETTER.time}</span></span></div>
    </div>
    {story && <span class="chip payout"><span class="icircle sm"><Icon name="card" size={16} /></span><span><b>{payoutChip[0]}</b><small>{payoutChip[1]}</small></span></span>}
  </div>
</div>
<style>
  .doc-stage { position: relative; width: 100%; max-width: 560px; margin: 0 auto; display: grid; place-items: center; container-type: inline-size; }
  .doc-stage.stage { aspect-ratio: 5 / 4.3; border-radius: var(--radius-l); background: radial-gradient(110% 80% at 30% 20%, #ffffff 0%, var(--color-surface) 48%, var(--color-surface-strong) 100%); }
  .stack { position: relative; width: 74%; }
  .sheet { position: relative; background: #fff; border-radius: var(--radius-m); padding: 6.5% 7%; color: var(--color-text); text-align: left;
    box-shadow: 0 0 0 1px rgba(11,15,25,.05), 0 24px 50px -24px rgba(11,15,25,.35), 0 8px 18px -10px rgba(11,15,25,.18); }
  .doc-stage:not(.stage) .stack { width: min(440px, 68%); } /* M03: groessere Buehne, groesseres Blatt */
  .doc-stage:not(.stage) .sheet { box-shadow: 0 0 0 1px rgba(11,15,25,.05), 0 40px 70px -30px rgba(0,0,0,.6), 0 12px 24px -12px rgba(0,0,0,.35); }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5%; }
  .ref { font-size: clamp(.7rem, 2.4cqw, .74rem); color: var(--color-muted); letter-spacing: .06em; font-variant-numeric: tabular-nums; }
  .title { display: flex; align-items: center; gap: 10px; margin-bottom: 4%; }
  .title > div { flex: 1; min-width: 0; }
  h3 { font-size: clamp(.8rem, 3.6cqw, 1.05rem); margin: 0; letter-spacing: -.01em; line-height: 1.2; }
  .meta { margin: 2px 0 0; font-size: clamp(.7rem, 2.4cqw, .74rem); color: var(--color-muted); }
  .pill { font-size: clamp(.66rem, 2.2cqw, .68rem); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: var(--color-accent); border-radius: var(--radius-pill); padding: .35em .8em; flex: none; }
  .to { font-size: clamp(.7rem, 2.6cqw, .8rem); color: var(--color-muted); margin: 0 0 4%; }
  .facts { display: grid; margin: 0 0 5%; }
  .facts div { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--color-border); padding: 3% 0; }
  dt { font-size: clamp(.7rem, 2.6cqw, .8rem); color: var(--color-muted); }
  dd { margin: 0; font-weight: 600; font-size: clamp(.72rem, 2.8cqw, .86rem); font-variant-numeric: tabular-nums; text-align: right; }
  .foot { display: flex; justify-content: space-between; align-items: center; font-size: clamp(.7rem, 2.6cqw, .8rem); font-weight: 600; }
  .dl { display: inline-flex; align-items: center; gap: 6px; }
  .dl :global(svg) { transform: rotate(90deg); }
  .seal { display: inline-flex; align-items: center; gap: 5px; color: var(--color-accent); }
  .doc-stage :global(.icircle.sm) { width: 34px; height: 34px; background: var(--color-accent-soft); color: var(--color-accent); }
  /* Pruef-Fusszeile (M08): QR 44 px in Tinte, Link mit Referenz, Pruefzeit; am Telefon entfaellt sie (das Blatt bleibt kompakt) */
  .verify { display: grid; grid-template-columns: 44px 1fr; gap: 12px; align-items: center; border-top: 1px solid var(--color-border); margin-top: 5%; padding-top: 4%; font-size: clamp(.62rem, 2.2cqw, .7rem); color: var(--color-muted); line-height: 1.35; }
  .qr :global(svg) { display: block; width: 44px; height: 44px; }
  .vtxt { display: grid; gap: 3px; min-width: 0; }
  .vtxt b { font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: .04em; color: var(--color-text); }
  .vok { display: inline-flex; align-items: center; gap: 4px; color: var(--color-accent); font-weight: 600; }
  @media (max-width: 600px) { .verify { display: none; } }
  /* Erscheinen (Jan 18.09. spaet): Zeilen nacheinander, Status-Pill springt zuletzt auf; Ausloeser ist der Sichtbarkeits-Marker des Blocks */
  :global([data-rv].in) .facts div { animation: rowIn .55s var(--ease-out) both; animation-delay: calc(.2s + var(--i, 0) * .13s); }
  :global([data-rv].in) .pill { animation: pillIn .5s cubic-bezier(.2, 1.4, .3, 1) both; animation-delay: .95s; }
  :global([data-rv].in) .seal { animation: rowIn .5s var(--ease-out) both; animation-delay: 1.1s; }
  /* Keyframes rowIn und pillIn: motion.css (M01) */
  @media (prefers-reduced-motion: reduce) { .facts div, .pill, .seal { animation: none !important; } }
  /* ScrollStory (M05): der Brief antwortet den Schritten. Stufe 1 ("Tell us who you are"): Kopf, Titel, Adresse, Pille "Draft",
     Zeilen gedimmt. Stufe 2 ("Send the deposit"): Zeile 1 leuchtet, Betrag laeuft hoch (Skript), Pille "Pending". Stufe 3 ("Hold the
     letter"): Pille "Issued" springt auf, Fusszeile und Zeilen 3 und 4 erscheinen. Stufe 4 ("Unlock your money"): Zeile 2 leuchtet,
     der Auszahlungs-Chip steigt unter dem Blatt auf. Die Zeit-Choreografie ([data-rv].in) gilt nicht fuer den Story-Brief. */
  :global([data-rv].in) .is-story .facts div, :global([data-rv].in) .is-story .pill, :global([data-rv].in) .is-story .seal { animation: none; }
  .is-story .facts div, .is-story .foot, .is-story .verify, .is-story .chip { transition: opacity var(--dur-scene) var(--ease-out-soft), transform var(--dur-scene) var(--ease-out-soft); }
  .pills { position: relative; flex: none; display: grid; }
  .pills .pill { grid-area: 1 / 1; opacity: 0; transform: scale(.6); transition: opacity .3s var(--ease-out), transform .5s var(--ease-spring); }
  :global([data-story][data-stage]) .is-story .facts div { opacity: .28; transform: translateY(6px); }
  :global([data-story][data-stage]) .is-story .foot, :global([data-story][data-stage]) .is-story .verify { opacity: 0; }
  :global([data-story]:is([data-stage="0"], [data-stage="1"])) .is-story .pill[data-s="1"] { opacity: 1; transform: none; }
  :global([data-story][data-stage="2"]) .is-story .pill[data-s="2"] { opacity: 1; transform: none; }
  :global([data-story]:is([data-stage="3"], [data-stage="4"])) .is-story .pill[data-s="3"] { opacity: 1; transform: none; }
  :global([data-story]:is([data-stage="2"], [data-stage="3"], [data-stage="4"])) .is-story .facts div:nth-child(1) { opacity: 1; transform: none; }
  :global([data-story]:is([data-stage="3"], [data-stage="4"])) .is-story .facts div:nth-child(3), :global([data-story]:is([data-stage="3"], [data-stage="4"])) .is-story .facts div:nth-child(4), :global([data-story]:is([data-stage="3"], [data-stage="4"])) .is-story .foot, :global([data-story]:is([data-stage="3"], [data-stage="4"])) .is-story .verify { opacity: 1; transform: none; }
  :global([data-story][data-stage="4"]) .is-story .facts div:nth-child(2) { opacity: 1; transform: none; }
  /* Auszahlungs-Chip unter dem Blatt: weiss, wie der Chip der Produktkarten auf der Startseite */
  .chip { position: absolute; inset-inline-end: -6%; bottom: -9%; display: flex; align-items: center; gap: 10px; background: #fff; color: var(--color-text); border-radius: 18px; padding: 10px 14px 10px 10px; box-shadow: 0 20px 40px -20px rgba(11,15,25,.5), 0 0 0 1px rgba(11,15,25,.05); font-size: clamp(.7rem, 2.6cqw, .84rem); line-height: 1.25; opacity: 0; transform: translateY(8px); }
  .chip b { display: block; font-weight: 600; }
  .chip small { display: block; color: var(--color-muted); font-size: .9em; }
  .chip :global(.icircle.sm) { width: 32px; height: 32px; background: var(--color-accent-soft); color: var(--color-accent); }
  :global([data-story][data-stage="4"]) .is-story .chip { opacity: 1; transform: none; }
  @media (max-width: 600px) { .chip { inset-inline-end: 2%; bottom: -7%; } }
  @media (max-width: 800px) { .stack { width: 82%; } }
  @media (max-width: 600px) { .doc-stage:not(.stage) .stack { width: 92%; } } /* M03: Lesbarkeit ab 11 px am Telefon */
</style>
