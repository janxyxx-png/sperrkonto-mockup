---
/**
 * Generischer Abschnitt-Renderer. Gruppiert Bloecke in Raster (Pricing, Zitate,
 * Buttons) und legt bei genau einem grossen Bild ein Zwei-Spalten-Layout an.
 */
import type { Section, Block } from '../lib/content';
import { route, pageIn } from '../lib/content';
import BlockView from './Block.astro';
import PhoneMock from './PhoneMock.astro';
import CardMock from './CardMock.astro';
import BookMock from './BookMock.astro';
import DocMock from './DocMock.astro';
import { photoFor, photosForPosts } from '../lib/photos';
import Icon from './Icon.astro';
import Illustration from './Illustration.astro';
import { illoFor } from '../lib/illo';
import { stepIcon } from '../lib/step-icons';
import { parseSteps } from '../lib/steps';
import StoreBadges from './StoreBadges.astro';
import Photo from './Photo.astro';
import { type Locale, t } from '../lib/i18n';
interface Props { section: Section; index: number; locale?: Locale; refSection?: Section; seen?: Set<string>; bg?: boolean; pricingKeep?: RegExp; skipStats?: boolean; compact?: boolean }
// seen: von DataPage je Seite geteiltes Set der schon gezeigten Mockup-Arten (Stolperstein-Rundgang 18.09. spaet: dasselbe Telefon dreimal je Seite)
// bg: DataPage setzt auf Seiten ohne eigene Flaechenangaben den Wechsel weiss/grau (Seitenharmonie, Jan 18.09. spaet)
// skipStats / compact (M06): der Sperrkonto-Planer folgt direkt auf den Kostenblock; das Kennzahlenraster entfaellt, der Abstand nach unten wird knapp
const { section: rawSection, index, locale = 'en', refSection, seen, bg, pricingKeep, skipStats = false, compact = false } = Astro.props;
// Hub-Seiten: nach der Abschnitts-H2 folgen Artikel-Teaser als "Bild, H2, Absatz". Diese H2 sind Kartentitel, keine Abschnitte.
const demoteTeasers = (bs: Block[]): Block[] => {
  if (!(bs[0]?.type === 'heading' && bs[0].level === 2)) return bs;
  const teaser = (i: number) => bs[i]?.type === 'heading' && (bs[i] as { level: number }).level === 2 && bs[i - 1]?.type === 'image' && bs[i + 1]?.type === 'paragraph';
  const hits = bs.map((_, i) => i > 0 && teaser(i)).filter(Boolean).length;
  return hits >= 2 ? bs.map((b, i) => (i > 0 && teaser(i) ? ({ ...b, level: 3 } as Block) : b)) : bs;
};
const section: Section = { ...rawSection, background: bg ?? rawSection.background, blocks: demoteTeasers(rawSection.blocks) };
// Uebersetzte Seiten haben dieselbe Blockstruktur wie das englische Original. Alle Heuristiken, die auf
// Textmuster schauen (Kicker, Schritte, Kennzahlen, Themenwahl der Mockups), lesen deshalb den englischen
// Block an derselben Stelle; gerendert wird der uebersetzte.
const refBlocks: Block[] = refSection && refSection.blocks.length === rawSection.blocks.length ? demoteTeasers(refSection.blocks) : section.blocks;
const enOf = new Map<Block, Block>(section.blocks.map((b, i) => [b, refBlocks[i]]));
const en = (b: Block): Block => enOf.get(b) ?? b;

/** Feste Spaltenzahl statt auto-fit: Raster bleiben symmetrisch (Jans Regel vom 18.09.), Umbruch per Breakpoint. */
const colsFor = (n: number) => `cols-${n <= 4 ? n : n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : n % 4 >= n % 3 ? 4 : 3}`;
const isBigImage = (b: Block) => b.type === 'image' && !/icn|icon|width=(\d{1,2}|1\d\d)&|badge-/.test(b.src);
const isHero = index <= 1 && section.blocks.some((b) => b.type === 'heading' && b.level === 1);
// Breadcrumb-Zeile: erste Sektion, nur eine kurze Liste ohne Ueberschrift
const isCrumb = index === 0 && section.blocks.length === 1 && section.blocks[0].type === 'list' && section.blocks[0].items.length <= 3;
const bigImages = section.blocks.filter(isBigImage);
const hasPricing = section.blocks.some((b) => b.type === 'pricing');
// Vergleichstabellen (Liste "<strong>Label</strong>: A / B") brauchen die volle Breite, also keine zwei Spalten
const isTableList = (b0: Block) => { const b = en(b0); return b.type === 'list' && !b.ordered && b.items.length >= 2 && b.items.every((i) => /^<strong>.*<\/strong>\s*:\s*.+\s\/\s.+$/s.test(i.html.trim())); };
const hasTable = section.blocks.some(isTableList);
const twoCol = !isHero && !hasPricing && !hasTable && bigImages.length === 1 && section.blocks.length >= 2;
// Welches Produkt-Mockup den Bildplatzhalter ersetzt: App-Kontext => Telefon, sonst Karte
const sectionText = refBlocks.map((b) => (b.type === 'heading' ? b.text : b.type === 'paragraph' ? b.html : '')).join(' ');
const mockKind = /companion|roadmap|\bapps?\b|smartphone|mobile|portal/i.test(sectionText) ? 'phone' : /guide|ebook|e-book|download|checklist|template|handbook/i.test(sectionText) ? 'book' : /webinar|session|video|zoom|recording|watch/i.test(sectionText) ? 'video' : /bank account|current account|iban|debit|card/i.test(sectionText) ? 'card' : 'doc';
// Dokument-Mockup: Titel und Zeilen passend zum Thema
const docProps = /insur|health|cover/i.test(sectionText) ? { title: 'Insurance certificate', items: ['Statutory health insurance', 'Valid from arrival', 'Travel cover for your first weeks', 'English-speaking service'], status: 'Issued' }
  : /opportunity card|chancenkarte|job seeker|job search|skilled worker|work visa|working in germany|employment/i.test(sectionText) ? { title: 'Opportunity Card', items: ['Recognised qualification', 'Proof of funds', 'Health insurance', 'Points: 6 of 6'], status: 'Eligible' }
  : /stud|universit|admission|enrol/i.test(sectionText) ? { title: 'University admission', items: ['Admission letter', 'Language certificate', 'Proof of funds', 'Health insurance'], status: 'Complete' }
  : { title: 'Visa application', items: ['Blocked Account confirmation', 'Health Insurance certificate', 'Travel Health Insurance', 'Bank Account'], status: 'Complete' };
// Hero-Telefon zeigt einen Screen passend zum Seitenthema
// Massgeblich ist die Ueberschrift; treffen mehrere Themen zu (Buendelseite), bleibt der Produktstatus
const headText = (refBlocks.find((b) => b.type === 'heading') as { text?: string } | undefined)?.text ?? sectionText;
const topics = ([['events', /webinar|session/i], ['work', /opportunity|job|work|employ|skilled|career/i], ['insurance', /insur|health/i], ['money', /bank account|current account|girokonto|iban|spending/i], ['account', /blocked account|deposit|sperrkonto|proof of funds/i], ['study', /stud|universit|programme|scholar|roadmap|companion/i]] as const).filter(([, re]) => re.test(headText)).map(([k]) => k);
const phoneVariant = topics.length === 1 ? topics[0] : 'setup';
// Buchtitel: die Ueberschrift, oder der kurze Absatz danach, wenn die Ueberschrift nur "Free eBook" sagt
const bookHeadEn = (refBlocks.find((b) => b.type === 'heading') as { text?: string } | undefined)?.text?.replace(/<[^>]+>/g, '') ?? 'Guide';
const bookHead = (section.blocks.find((b) => b.type === 'heading') as { text?: string } | undefined)?.text?.replace(/<[^>]+>/g, '') ?? 'Guide';
const bookSub = (section.blocks.find((b) => b.type === 'paragraph') as { html?: string } | undefined)?.html?.replace(/<[^>]+>/g, '').trim();
const bookTitle = /^(free )?(ebook|e-book|guide|download|checklist|template)s?$/i.test(bookHeadEn) && bookSub && bookSub.length <= 40 ? bookSub : bookHead;
// Zwei Icon-Platzhalter in einem App-Abschnitt waren im Original die Store-Badges
const iconCount = section.blocks.filter((b) => b.type === 'image' && !isBigImage(b)).length;
const storeBadges = mockKind === 'phone' && iconCount === 2;

// --- Karten-Heuristik: "Titel + Bild in der Naehe" wiederholt sich => Raster ---
const strongTitle = (b0: Block) => { const b = en(b0); return b.type === 'paragraph' && /^<strong>[^<]+<\/strong>$/.test(b.html.replace(/<br\s*\/?>/g, '').replace(/\s+/g, ' ').trim()); };
const titleText = (b: Block) => b.type === 'heading' ? b.text : b.type === 'paragraph' ? b.html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim() : '';
const titleTextEn = (b: Block) => titleText(en(b));
const isTitle = (b: Block) => (b.type === 'heading' && b.level >= 3) || strongTitle(b);
const isCardStart = (bs: Block[], i: number) => {
  const b = bs[i];
  if (b.type === 'image' && bs[i + 1] && isTitle(bs[i + 1])) return true;
  if (isTitle(b) && (bs[i + 1]?.type === 'image' || bs[i + 2]?.type === 'image') && !(bs[i - 1]?.type === 'image')) return true;
  return false;
};
// Kicker: kurzer Absatz als Zwischentitel. Kein Kicker, wenn er eine Liste einleitet ("The bundle contains:").
const isKicker = (b0: Block, next?: Block) => { const b = en(b0); return b.type === 'paragraph' && !/<|\d/.test(b.html) && b.html.length <= 24 && /^[A-Z]/.test(b.html) && !/:\s*$/.test(b.html) && next?.type !== 'list'; };
const cardStartsImg = section.blocks.map((_, i) => isCardStart(section.blocks, i)).map((v, i, a) => v && !(a[i - 1] && section.blocks[i - 1].type === 'image'));
const cardCount = cardStartsImg.filter(Boolean).length;
// In einem Kartenraster beginnt nach einem Button auch ein bildloser Titel eine neue Karte (sonst landet ein <a> im <a>, z. B. /library)
const cardStarts = cardCount >= 2 ? section.blocks.map((b, i) => cardStartsImg[i] || (i > 0 && isTitle(b) && section.blocks[i - 1].type === 'button')) : cardStartsImg;
let useCards = !isHero && !twoCol && cardCount >= 2;
// Display-Zeilen im Hero: kurze Absaetze direkt nach der H1 (z. B. "Pay Less," / "Get More")
const display = new Set<number>();
if (isHero) {
  const h1 = section.blocks.findIndex((b) => b.type === 'heading' && b.level === 1);
  for (let i = h1 + 1; i < section.blocks.length; i++) { const b = refBlocks[i]; if (b.type === 'paragraph' && b.html.length <= 16) display.add(i); else break; }
}

type Stat = { label: string; value: string; caption?: string };
type Group = { kind: 'pricing' | 'quotes' | 'buttons' | 'block' | 'figure' | 'cards' | 'display' | 'kicker' | 'stats'; blocks: Block[]; cards?: Block[][]; stats?: Stat[] };
const isIconImg = (b: Block) => b.type === 'image' && !isBigImage(b);
// Kennzahlen: fetter Absatz als Label, danach eine H3 mit reiner Zahl ("€11,904"), optional eine kurze Erlaeuterung
const isStatValue = (b0: Block) => { const b = en(b0); return b.type === 'heading' && b.level >= 3 && /^[€$£]?\s?[\d.,]+\s?(%|€)?$/.test(b.text.trim()); };
const buildGroups = (): Group[] => {
const groups: Group[] = [];
const statSkip = new Set<number>();
section.blocks.forEach((b, i) => {
  if (statSkip.has(i)) return;
  if (useCards && cardStarts[i]) { groups.push({ kind: 'cards', blocks: [], cards: [[b]] }); return; }
  const last = groups[groups.length - 1];
  const prevBlock = section.blocks[i - 1];
  // "Tip!" als eigener fetter Absatz + Erlaeuterung => ein Hinweiskasten
  if (b.type === 'paragraph' && strongTitle(b) && /^tipp?!?:?$/i.test(titleTextEn(b)) && section.blocks[i + 1]?.type === 'paragraph') {
    const nb = section.blocks[i + 1] as { html: string };
    statSkip.add(i + 1);
    groups.push({ kind: 'block', blocks: [{ type: 'paragraph', html: `<strong>${t(locale, 'tip')}</strong> ${nb.html}`, tip: true } as Block] });
    return;
  }
  if (isStatValue(b) && prevBlock && strongTitle(prevBlock) && last?.kind === 'block' && last.blocks[0] === prevBlock) {
    groups.pop();
    const nb = section.blocks[i + 1];
    const caption = nb && nb.type === 'paragraph' && !strongTitle(nb) && nb.html.replace(/<[^>]+>/g, '').length <= 60 ? nb.html : undefined;
    if (caption) statSkip.add(i + 1);
    const stat: Stat = { label: titleText(prevBlock), value: b.type === 'heading' ? b.text.trim() : '', caption };
    const l2 = groups[groups.length - 1];
    if (l2?.kind === 'stats') l2.stats!.push(stat); else groups.push({ kind: 'stats', blocks: [], stats: [stat] });
    return;
  }
  const curCard = last?.kind === 'cards' ? last.cards![last.cards!.length - 1] : null;
  // Eine zweite H3 in derselben Karte = neues Produkt = neue Karte; eine H3 vor der ersten Karte (Partner ohne Bild) ebenso
  if (useCards && curCard && b.type === 'heading' && b.level === 3 && curCard.some((x) => x.type === 'heading' && x.level === 3)) { groups.push({ kind: 'cards', blocks: [], cards: [[b]] }); return; }
  if (useCards && !curCard && b.type === 'heading' && b.level >= 3 && section.blocks.slice(i + 1).some((x) => x.type === 'paragraph')) { groups.push({ kind: 'cards', blocks: [], cards: [[b]] }); return; }
  const next = section.blocks[i + 1];
  // Icon-Karten (Feature-Kacheln) enden vor Buttons und Kickern; Produktkarten mit grossem Bild behalten ihre Buttons
  const iconCard = !!curCard && curCard.some(isIconImg);
  const endsCard = !curCard || isKicker(b, next) || (iconCard && b.type === 'button') || (b.type === 'heading' && b.level <= 2) || ['pricing', 'faq', 'quote'].includes(b.type);
  const inCard = useCards && !!curCard && !endsCard;
  if (inCard) { curCard!.push(b); return; }
  // Verwaiste Bild-Platzhalter zwischen Karten (im Original Deko-Grafiken) entfallen
  if (useCards && isBigImage(b) && !cardStarts[i]) return;
  // Einzelne Icon-Platzhalter ausserhalb von Karten (Partnerlogos, Store-Badges) tragen nichts => weg
  if (isIconImg(b)) return;
  // Bildplatzhalter ausserhalb von Hero, Zwei-Spalten-Layout und Karten (Deko im Original) entfallen; eigene Bilder folgen spaeter
  if (isBigImage(b) && !twoCol && !isHero && b.src === 'image') return;
  // Doppelte Buttons (Desktop-/Mobil-Variante im Original) nur einmal
  if (b.type === 'button' && last?.kind === 'buttons' && last.blocks.some((x) => x.type === 'button' && x.text === b.text && x.href === b.href)) return;
  const kind: Group['kind'] = display.has(i) ? 'display' : useCards && isKicker(b, next) ? 'kicker' : b.type === 'pricing' ? 'pricing' : b.type === 'quote' ? 'quotes' : b.type === 'button' ? 'buttons' : isBigImage(b) && (twoCol || isHero) ? 'figure' : 'block';
  if (last && last.kind === kind && kind !== 'block' && kind !== 'figure' && kind !== 'cards' && kind !== 'kicker') last.blocks.push(b);
  else groups.push({ kind, blocks: [b] });
});
return groups;
};
let groups = buildGroups();
// Karten ohne Inhalt (nur ein Titel) => Heuristik hat danebengegriffen, Abschnitt linear rendern
const hollow = groups.some((g) => g.kind === 'cards' && g.cards!.some((c) => !c.some((b) => ['paragraph', 'list'].includes(b.type))));
if (useCards && hollow) { useCards = false; groups = buildGroups(); }
// Karten-Gruppen, die direkt aufeinander folgen, zusammenlegen
const merged: Group[] = [];
for (const g of groups) { const l = merged[merged.length - 1]; if (g.kind === 'cards' && l?.kind === 'cards') l.cards!.push(...g.cards!); else merged.push(g); }
// Ein Button nur in der letzten Karte ("All guides") gehoert zum Abschnitt, nicht zur Karte
for (let gi = 0; gi < merged.length; gi++) {
  const g = merged[gi]; if (g.kind !== 'cards' || g.cards!.length < 2) continue;
  const withBtn = g.cards!.filter((c) => c.some((b) => b.type === 'button'));
  const lastCard = g.cards![g.cards!.length - 1];
  if (withBtn.length === 1 && withBtn[0] === lastCard && lastCard[lastCard.length - 1].type === 'button') {
    let k = lastCard.length; while (k > 0 && lastCard[k - 1].type === 'button') k--;
    const btns = lastCard.splice(k);
    merged.splice(gi + 1, 0, { kind: 'buttons', blocks: btns });
  }
}
const buttonsOnly = section.blocks.every((b) => b.type === 'button');
const figure = merged.find((g) => g.kind === 'figure');
let rest = merged.filter((g) => g.kind !== 'figure');
// M06: mit skipStats entfallen die Kennzahl-Gruppen und die H3 direkt vor der ersten ("A twelve-month Blocked Account at a glance");
// Kapitel-H2 und Lead bleiben stehen, den Rest zeigt der Planer (DepositEstimator) darunter
if (skipStats) {
  const si = rest.findIndex((g) => g.kind === 'stats');
  if (si > 0) { const p = rest[si - 1]; if (p.kind === 'block' && p.blocks[0].type === 'heading' && p.blocks[0].level === 3) rest.splice(si - 1, 1); }
  rest = rest.filter((g) => g.kind !== 'stats');
}
// Foto aus der Serie statt Mockup (14-PROMPT Aufgabe 1): Sektion wird zweispaltig, Foto rechts
const photo = section.photo;
// Langtext einklappen (14-PROMPT Aufgabe 3): Ueberschrift und erster Absatz bleiben sichtbar, der Rest steht in <details>
// (vollstaendig im HTML, ohne JavaScript lesbar). Beschriftung aus ui-strings.
const collapse = !!section.collapse;
const firstParaIdx = rest.findIndex((g) => g.kind === 'block' && g.blocks[0].type === 'paragraph');
const visibleN = collapse ? (firstParaIdx >= 0 ? firstParaIdx + 1 : 1) : rest.length;
const hidden = collapse ? rest.slice(visibleN) : [];
if (collapse) rest = rest.slice(0, visibleN);
const sectionTitleEn = (refBlocks.find((b) => b.type === 'heading') as { text: string } | undefined)?.text ?? '';
const sectionTitle = (section.blocks.find((b) => b.type === 'heading') as { text: string } | undefined)?.text ?? sectionTitleEn;
// Hero: Buttons stehen immer vor Checklisten (Reihenfolge im Original schwankt)
if (isHero) {
  const bi = rest.findIndex((g) => g.kind === 'buttons'), li = rest.findIndex((g) => g.kind === 'block' && g.blocks[0].type === 'list');
  if (bi > li && li >= 0) { const [bg] = rest.splice(bi, 1); rest.splice(li, 0, bg); }
}
const headingOnly = section.blocks.length <= 2 && section.blocks.every((b) => b.type === 'heading');
// Endet ein Abschnitt mit einer Ueberschrift (im Original folgte eine Bildergalerie), steht eine Platzhalter-Galerie darunter
const lastBlock = section.blocks[section.blocks.length - 1];
const trailingHeading = section.blocks.length > 1 && lastBlock?.type === 'heading' && lastBlock.level <= 3 && !isHero && !headingOnly && !isStatValue(lastBlock);
// ... oder ein Formular (Download, Newsletter, Kontakt), wenn die Ueberschrift danach klingt
const trailingForm = trailingHeading && /download|sign up|register|subscribe|newsletter|contact|get in touch|apply|request|notified/i.test((en(lastBlock) as { text: string }).text);
const trailingGallery = trailingHeading && !trailingForm;
const widgetLabel = /review|customer|rating|trust|say/i.test(sectionText) ? 'reviews' : /quiz|calculat|check|test|find/i.test(sectionText) ? 'quiz' : /video|watch|question|story|stories/i.test(sectionText) ? 'video' : 'widget';
const isFootnotes = refBlocks[0]?.type === 'heading' && /^footnotes$/i.test(refBlocks[0].text);
// Display-Stufe der Sektionsueberschrift (M03): Kapiteloeffner fuer Schritte und Kosten, Utility fuer die FAQ; sonst die 52-px-Stufe
const h2Class = section.anchor === 'how-it-works' || section.anchor === 'costs' ? 'chapter' : section.anchor === 'faq' ? 'util' : undefined;
// Ein einzelnes Zitat als eigene Sektion (Sperrkonto s8) wird Pull Quote vor der FAQ statt einer 448 px hohen Kastensektion (M03)
const loneQuote = section.blocks.length === 1 && section.blocks[0].type === 'quote';
// Sektionen, die nur aus einer Ueberschrift bestehen (im Original ein eingebettetes Widget), bekommen echten Inhalt statt
// eines Platzhalters (Rundgang 18.09. spaet): Stimmen der Startseite, ein kurzer Pruef-Dialog oder ein Formular.
const voices = headingOnly && widgetLabel === 'reviews' ? (() => { const h = pageIn('home', locale).page, hr = pageIn('home', 'en').page; const pick = (pg: typeof h) => pg.sections.flatMap((x) => x.blocks).filter((b) => b.type === 'quote').slice(0, 3); return { q: pick(h), r: pick(hr) }; })() : null;
const quizOpts = (k: 'quiz.o1' | 'quiz.o2' | 'quiz.o3') => t(locale, k).split('|');
// Hub-Linklisten (h3 + Textlink im Wechsel, ab drei Paaren) werden Karten statt nackter "Read more"-Zeilen
type LinkItem = { title: string; href: string; text: string };
const linkRuns: Map<number, LinkItem[]> = new Map();
{
  let i = 0;
  while (i < rest.length) {
    const items: LinkItem[] = []; let j = i;
    while (j + 1 < rest.length) {
      const a = rest[j], b = rest[j + 1];
      const h = a.kind === 'block' && a.blocks.length === 1 && a.blocks[0].type === 'heading' && a.blocks[0].level >= 3 ? a.blocks[0] : null;
      const l = b.kind === 'buttons' && b.blocks.length === 1 && b.blocks[0].type === 'button' ? b.blocks[0] : null;
      if (!h || !l) break;
      items.push({ title: h.text, href: l.href, text: l.text }); j += 2;
    }
    if (items.length >= 3) { linkRuns.set(i, items); rest.splice(i, items.length * 2, { kind: 'block', blocks: [{ type: 'paragraph', html: '' }] }); i += 1; } else i += 1;
  }
}
const figurePlaceholder = !!figure && figure.blocks[0].type === 'image' && figure.blocks[0].src === 'image';
// Welches Objekt den Platzhalter fuellt (Rundgang 18.09. spaet): im Hero nur ein Telefon, wenn der Screen zum Thema
// passt (Konto, Versicherung, Arbeit) oder die Seite die App meint; sonst ein Foto der cineastischen Serie. Auf der
// Seite schon gezeigte Mockup-Arten (seen) werden nicht wiederholt, sondern durch ein Foto ersetzt.
// Telefon im Hero nur auf Seiten, die das Produkt in der App zeigen (Bank-, Sperrkonto, Versicherung, Arbeit), nicht auf
// Partner- und Erklaerseiten (Seitenharmonie: vier Partnerseiten mit demselben Telefon)
const productPage = /^\/(?:[a-z]{2}\/)?(?:blocked-account|german-bank-account|health-insurance|complete-setup|study-loan|current-account)$/.test(Astro.url.pathname);
const heroPhone = isHero && (mockKind === 'phone' || (productPage && ['money', 'insurance', 'work', 'account'].includes(phoneVariant)));
const figureKey = mockKind === 'doc' ? `doc:${docProps.title}` : mockKind;
const figureKind: 'book' | 'phone' | 'video' | 'doc' | 'card' | 'photo' = !figurePlaceholder ? 'photo'
  : isHero ? (mockKind === 'book' ? 'book' : heroPhone ? 'phone' : 'photo')
  : seen?.has(figureKey) ? 'photo' : mockKind;
if (figurePlaceholder && figureKind !== 'photo' && seen) seen.add(figureKind === 'doc' ? figureKey : figureKind);
// Seed mit Seitenpfad ohne Sprachpraefix: gleiche Seite in drei Sprachen = gleiches Foto, Schwesterseiten (die vier
// Partnerseiten begannen alle mit "Our ... partner") = verschiedene Fotos (Rundgang 19.09.)
const pagePath = Astro.url.pathname.replace(/^\/(ur|pa)(?=\/|$)/, '');
const figurePhoto = section.figure ?? photoFor(sectionText, `${pagePath}:${index}:${sectionText.slice(0, 40)}`); // figure: festes Foto aus den Daten (Partnerseiten)
// Karten: nachlaufende Buttons als Reihe unten; Bildkopf nur, wenn jede Karte des Rasters einen hat (sonst uneinheitlich)
// Illustration je Karte nach Titel (lib/illo.ts)
const splitCard = (c: Block[], keepFigure: boolean) => {
  let i = c.length; while (i > 0 && c[i - 1].type === 'button') i--;
  const title = c.map(titleTextEn).find((t) => t) ?? '';
  const body = c.slice(0, i).filter((b, k) => b.type !== 'image' || isIconImg(b) || (k === 0 && keepFigure)).map((b) => (b.type === 'image' && !isIconImg(b) ? ({ ...b, illo: illoFor(title) } as Block) : b));
  const buttons = c.slice(i).filter((b, k, a) => b.type === 'button' && a.findIndex((x) => x.type === 'button' && x.text === b.text && x.href === b.href) === k);
  return { body, buttons };
};
const gridKeepsFigure = (cards: Block[][]) => cards.every((c) => c[0].type === 'image' && !isIconImg(c[0]));
