---
/**
 * Eigene Flach-Illustrationen im Farbsystem der Seite (Tinte, Grau, ein Bordeaux-Punkt).
 * Reines Inline-SVG, 4:3, keine Fremdgrafiken. Auswahl nach Thema ueber lib/illo.ts.
 */
import type { IlloName } from '../lib/illo';
interface Props { name: IlloName; class?: string; bare?: boolean }
