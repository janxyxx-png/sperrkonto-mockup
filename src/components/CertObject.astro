---
/** Das Versicherungszertifikat als Objekt (28, Jan: die Versicherungsseite war die einzige Produktseite ohne Objekt in der
 *  Buehne). Dieselbe Sprache wie die Dokumentkarte (DocObject): gerade, weiss, Radius der Karten, Zeilen mit Haarlinie,
 *  Status-Pill in Bordeaux. Inhalt Englisch und LTR wie das echte Dokument; die Werte sind die Beispielwerte der Seite
 *  (Praemie unter 30 etwa 120 Euro, Reiseschutz 92 Tage wie im App-Screen, Kundin und Geburtsdatum wie in der Verifikation).
 *  M02: Referenz, Datum, Praemie und Reisetage kommen aus der Demo-Welt (portal-demo.ts DEMO_CERT / DEMO_DATA). */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import QRCode from 'qrcode';
import { DEMO_CERT, DEMO_DATA, DEMO_ANCHORS, demoDate, demoDateShort } from '../lib/portal-demo';
// Pruefbares Zertifikat (M08): QR und Link auf die Behoerdenseite mit der Referenz
const verifyUrl = `${(Astro.site ?? new URL('http://localhost:4321')).href.replace(/\/$/, '')}/authorities?ref=${DEMO_CERT.ref}`;
const qr = await QRCode.toString(verifyUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', width: 44, color: { dark: '#0b0f19', light: '#0000' } });
interface Props { class?: string; stage?: boolean; vt?: string }
// vt (M13): Name fuer den Seitenwechsel (View Transition); dasselbe Objekt auf zwei Seiten reist statt zu blenden

const { class: cls, stage = true, vt } = Astro.props;
const eur2 = (n: number) => '€' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---
<div class:list={['doc-stage', cls, { stage }]} aria-hidden="true" dir="ltr" style={vt ? `view-transition-name:${vt}` : undefined}>
  <div class="stack">
    <div class="sheet">
      <div class="head"><Wordmark size=".85rem" /><span class="ref">{DEMO_CERT.ref}</span></div>
      <div class="title">
        <span class="icircle sm"><Icon name="shield" size={18} /></span>
        <div><h3>Health Insurance Certificate</h3><p class="meta">Statutory plan · issued <span style="white-space:nowrap">{demoDate(DEMO_CERT.issued, 'en')}</span></p></div>
        <span class="pill">Active</span>
      </div>
      <p class="to">{DEMO_DATA.name} · born 14 March 2003 · {DEMO_DATA.from}, Pakistan</p>
      <dl class="facts">
        <div style="--i:0"><dt>Cover starts</dt><dd>Day of arrival in Germany</dd></div>
        <div style="--i:1"><dt>Travel cover</dt><dd>First {DEMO_CERT.travelDays} days included</dd></div>
        <div style="--i:2"><dt>Monthly premium</dt><dd data-count>{eur2(DEMO_CERT.premium)}</dd></div>
        <div style="--i:3"><dt>Accepted by</dt><dd>Embassies and universities</dd></div>
      </dl>
      <div class="foot"><span class="dl"><Icon name="arrow" size={14} /> Download PDF</span><span class="seal"><Icon name="check" size={12} /> Verified</span></div>
      <div class="verify"><span class="qr" set:html={qr} /><span class="vtxt"><span>Verify this certificate: ecassets.com/authorities · <b>{DEMO_CERT.ref}</b></span><span class="vok"><Icon name="check" size={11} /> Verified {demoDateShort(DEMO_CERT.issued, 'en')} {DEMO_CERT.issued.slice(0, 4)} · {DEMO_ANCHORS.issuedTime}</span></span></div>
    </div>
  </div>
</div>
<style>
  .doc-stage { position: relative; width: 100%; max-width: 560px; margin: 0 auto; display: grid; place-items: center; container-type: inline-size; }
  .doc-stage.stage { aspect-ratio: 5 / 4.3; border-radius: var(--radius-l); background: radial-gradient(110% 80% at 30% 20%, #ffffff 0%, var(--color-surface) 48%, var(--color-surface-strong) 100%); }
  .stack { position: relative; width: 74%; }
  .sheet { position: relative; background: #fff; border-radius: var(--radius-m); padding: 6.5% 7%; color: var(--color-text); text-align: left;
    box-shadow: 0 0 0 1px rgba(11,15,25,.05), 0 24px 50px -24px rgba(11,15,25,.35), 0 8px 18px -10px rgba(11,15,25,.18); }
  .doc-stage:not(.stage) .stack { width: min(440px, 68%); } /* M03: groessere Buehne, groesseres Blatt */
  .doc-stage:not(.stage) .sheet { box-shadow: 0 0 0 1px rgba(11,15,25,.05), 0 40px 70px -30px rgba(0,0,0,.6), 0 12px 24px -12px rgba(0,0,0,.35); }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5%; }
  .ref { font-size: clamp(.7rem, 2.4cqw, .74rem); color: var(--color-muted); letter-spacing: .06em; font-variant-numeric: tabular-nums; }
  .title { display: flex; align-items: center; gap: 10px; margin-bottom: 4%; }
  .title > div { flex: 1; min-width: 0; }
  h3 { font-size: clamp(.8rem, 3.6cqw, 1.05rem); margin: 0; letter-spacing: -.01em; line-height: 1.2; }
  .meta { margin: 2px 0 0; font-size: clamp(.7rem, 2.4cqw, .74rem); color: var(--color-muted); }
  .pill { font-size: clamp(.66rem, 2.2cqw, .68rem); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: var(--color-accent); border-radius: var(--radius-pill); padding: .35em .8em; flex: none; }
  .to { font-size: clamp(.7rem, 2.6cqw, .8rem); color: var(--color-muted); margin: 0 0 4%; }
  .facts { display: grid; margin: 0 0 5%; }
  .facts div { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--color-border); padding: 3% 0; }
  dt { font-size: clamp(.7rem, 2.6cqw, .8rem); color: var(--color-muted); }
  dd { margin: 0; font-weight: 600; font-size: clamp(.72rem, 2.8cqw, .86rem); font-variant-numeric: tabular-nums; text-align: right; }
  .foot { display: flex; justify-content: space-between; align-items: center; font-size: clamp(.7rem, 2.6cqw, .8rem); font-weight: 600; }
  .dl { display: inline-flex; align-items: center; gap: 6px; }
  .dl :global(svg) { transform: rotate(90deg); }
  .seal { display: inline-flex; align-items: center; gap: 5px; color: var(--color-accent); }
  .doc-stage :global(.icircle.sm) { width: 34px; height: 34px; background: var(--color-accent-soft); color: var(--color-accent); }
  /* Pruef-Fusszeile (M08): QR 44 px in Tinte, Link mit Referenz, Pruefzeit; am Telefon entfaellt sie */
  .verify { display: grid; grid-template-columns: 44px 1fr; gap: 12px; align-items: center; border-top: 1px solid var(--color-border); margin-top: 5%; padding-top: 4%; font-size: clamp(.62rem, 2.2cqw, .7rem); color: var(--color-muted); line-height: 1.35; }
  .qr :global(svg) { display: block; width: 44px; height: 44px; }
  .vtxt { display: grid; gap: 3px; min-width: 0; }
  .vtxt b { font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: .04em; color: var(--color-text); }
  .vok { display: inline-flex; align-items: center; gap: 4px; color: var(--color-accent); font-weight: 600; }
  @media (max-width: 600px) { .verify { display: none; } }
  /* Erscheinen wie die Dokumentkarte: Zeilen nacheinander, Status-Pill springt zuletzt auf; Ausloeser ist der Sichtbarkeits-Marker des Blocks */
  :global([data-rv].in) .facts div { animation: rowIn .55s var(--ease-out) both; animation-delay: calc(.2s + var(--i, 0) * .13s); }
  :global([data-rv].in) .pill { animation: pillIn .5s cubic-bezier(.2, 1.4, .3, 1) both; animation-delay: .95s; }
  :global([data-rv].in) .seal { animation: rowIn .5s var(--ease-out) both; animation-delay: 1.1s; }
  /* Keyframes rowIn und pillIn: motion.css (M01) */
  @media (prefers-reduced-motion: reduce) { .facts div, .pill, .seal { animation: none !important; } }
  @media (max-width: 800px) { .stack { width: 82%; } }
  @media (max-width: 600px) { .doc-stage:not(.stage) .stack { width: 92%; } } /* M03: Lesbarkeit ab 11 px am Telefon */
</style>
