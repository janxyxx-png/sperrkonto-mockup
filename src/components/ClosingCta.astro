---
/** Abschluss-CTA: eine Zeile, ein Button. tone "dark" (Standard) oder "surface".
 *  Eine Foto-Kachel als Finale (Feinschliff 27) hat Jan am 20.09. abends verworfen ("einfach etwas zu viel"); die graue Flaeche bleibt. */
interface Props { title: string; cta: string; href: string; tone?: 'dark' | 'surface' }
const { title, cta, href, tone = 'dark' } = Astro.props;
---
<section class:list={['closing', tone === 'dark' ? 'section--dark on-dark' : 'surface']}>
  <div class="container">
    <h2 class="chapter">{title}</h2>
    <a class:list={['btn', tone === 'dark' ? 'btn-on-dark' : 'btn-primary']} href={href} data-cta-anchor data-astro-prefetch="viewport" data-commit>{cta}</a>
  </div>
</section>
<style>
  .closing { text-align: center; }
  /* M03: nach einer grauen FAQ lesen sich FAQ, Abschluss und Footer als ein Ende; oben ein Sektionsmass, unten Kapitelluft vor dem Footer */
  .closing.surface { background: var(--color-surface); padding: var(--section-y) 0 var(--chapter-y); }
  .closing h2 { max-width: 16ch; margin: 0 auto 32px; }
</style>
