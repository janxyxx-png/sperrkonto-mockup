---
/**
 * Funnel /app/start (18-NAECHSTES-LEVEL Hebel 1): Fragen, dann ein persoenlicher Plan, der die Eingaben verarbeitet.
 * Seit 20.09. (design-upgrade/25-EIN-PRODUKT-ZWEI-WEGE.md): ein Produkt (Complete Setup, Monatspreis, keine Einrichtung),
 * Zielgruppe Studierende und Fachkraefte (Au-pair und Familiennachzug entfallen), Sperrbetrag je Visumtyp (992 bzw. 1.091 im
 * Monat), die Finanzierungsfrage nur fuer Studierende und mit Wirkung: "I need financing" macht die Partnerbank zum Zahler
 * des Sperrbetrags (nichts zu ueberweisen, Buergenfrage im Kreditschritt), "I have the funds" zeigt den 500-Euro-Bonus.
 * Rein clientseitig, nichts wird gesendet. Texte: ui-strings (wiz.*) und funnel-copy.ts; Zahlen: facts.ts.
 *
 * Runde 29, M11 (nativer Ablauf): Leiste ueber der Karte mit "Frage a von b", Segmenten und rundem Zurueck-Knopf; Blaetter
 * wechseln gerichtet (View Transition, sonst WAAPI), der Zustand steht in sessionStorage (ec-wiz) und der Schritt in der URL
 * (?step=..., Browser-Zurueck geht im Funnel zurueck); Vorbelegung ueber ?group=|purpose=|from=|age=|arrival=|funding=|months=|rate=
 * (Sperrbetrag-Planer M06) und localStorage ec-plan; Ankunft als zwei Semesterkarten plus "anderer Monat".
 * M12 (lebender Plan): computeModel(a, rate) liefert ein Modell, render(model) schreibt Ergebnis UND die [data-plan]-Zeilen
 * der Plan-Karte (ab 1000 px rechts, klebend) bzw. des Streifens (darunter), ab der ersten Antwort.
 */
import App from '../layouts/App.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import PhotoStage from '../components/PhotoStage.astro';
import AppDuo from '../components/AppDuo.astro';
import { type Locale, localePath, t as tr } from '../lib/i18n';
import { FUNNEL, PKR_PER_EUR_EXAMPLE, TRANSFER_FEE_PCT_EXAMPLE, PREMIUM } from '../lib/funnel-copy';
import { PRICE, PRICE_DEPOSIT_WORK, money } from '../lib/facts';
import { markPh } from '../lib/placeholders';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = (k: Parameters<typeof tr>[1]) => tr(locale, k);
const lp = (p: string) => localePath(locale, p);
const f = FUNNEL[locale] ?? FUNNEL.en;
// Einwilligungssatz des Registrierungsschritts mit Links auf AGB und Datenschutz (Routen aus nav.json legal)
const consentHtml = f.acct.consent.replace('{terms}', `<a href="${lp('/general-terms-and-conditions')}">${f.acct.terms}</a>`).replace('{privacy}', `<a href="${lp('/privacy-policy')}">${f.acct.privacyPolicy}</a>`);
const purposes = [
  [t('wiz.study'), [t('wiz.p1'), t('wiz.p2'), t('wiz.p3'), t('wiz.p4'), t('wiz.p5'), t('wiz.p6'), t('wiz.p7')]],
  [t('wiz.other'), [t('wiz.o1'), t('wiz.o2')]],
] as const;
let optIndex = 0;
// Semesterkarten (M11): naechstes Wintersemester (Oktober) und Sommersemester (April) ab heute, chronologisch; das Skript
// rechnet sie beim Laden mit dem echten Datum nach. Monatsnamen: en-GB, sonst Urdu (auch fuer Shahmukhi-Punjabi).
const monthLocale = locale === 'en' ? 'en-GB' : 'ur';
const semesterOf = (kind: 'winter' | 'summer', now = new Date()) => { const y = now.getFullYear(), m = now.getMonth(), mo = kind === 'winter' ? 9 : 3; return new Date(m < mo ? y : y + 1, mo, 1); };
const semesters = (['winter', 'summer'] as const).map((k) => {
  const d = semesterOf(k);
  const [name, when] = f.arrivalPick[k].replace('{month}', d.toLocaleDateString(monthLocale, { month: 'long' })).replace('{year}', String(d.getFullYear())).split(' · ');
  return { k, ym: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`, name, when: when ?? '' };
}).sort((p, q) => p.ym.localeCompare(q.ym));
// Daten fuer das Skript: alles, was das Ergebnis je Antwort braucht
const data = {
  locale, monthLocale, rate: PKR_PER_EUR_EXAMPLE, feePct: TRANSFER_FEE_PCT_EXAMPLE, deposit: PRICE.deposit, depositWork: PRICE_DEPOSIT_WORK, monthly: PRICE.monthly, premium: PREMIUM,
  setupName: f.setupComplete, setupWhy: f.setupWhy, docs: f.docs, docsCommon: f.docsCommon, tl: f.tl, tlLoan: f.tlLoan,
  embassy: f.embassy, statutory: f.statutory, privatePlan: f.privatePlan, today: f.today, whatsappText: f.whatsappText,
  labels: { depositSub: f.depositSub, depositSubWork: f.depositSubWork, totalEur: f.totalEur, noSetupFee: f.noSetupFee, nothingToTransfer: f.nothingToTransfer, guarantorNote: f.guarantorNote },
  fund: f.fund, perMonth: t('perMonth'), calendarTitle: f.calendarTitle, docsProgress: f.docsProgress, stepOf: t('wiz.stepOf'), arrivalPick: f.arrivalPick,
};
---
<App title={t('wiz.title')} locale={locale} path="/app/start">
  <div class="wiz" data-wizard>
    <!-- Leiste (M11): Zurueck, "Frage a von b", Segmente; auf dem Telefon klebend -->
    <div class="wiz-rail" data-rail hidden>
      <button type="button" class="back" data-back hidden aria-label={t('back')} title={t('back')}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
      <div class="rail-prog" data-rail-prog>
        <p class="rail-count" data-count aria-live="polite"></p>
        <div class="track" role="progressbar" aria-label={t('progress')} aria-valuemin="1" data-progress></div>
      </div>
    </div>
    <!-- Laufender Plan unter 1000 px (M12): drei Werte, klebend unter der Leiste -->
    <div class="plan-strip" data-plan-strip hidden aria-label={f.acct.summary}>
      <div data-plan-row><small>{f.deposit}</small><b class="none" data-plan="deposit">–</b></div>
      <div data-plan-row><small>{f.glance.appt}</small><b class="none" data-plan="appointment">–</b></div>
      <div data-plan-row><small>{f.glance.docs}</small><b class="none" data-plan="docs">–</b></div>
    </div>

    <!-- Start (Jan 20.09.: "nicht so spannend gemacht"): links das Versprechen in drei Zeilen, rechts die App als Objekt auf Foto -->
    <section class="card white step start wide-card" data-step="start">
      <div class="start-grid">
        <div class="start-text">
          <p class="kicker">{t('getStarted')}</p>
          <h2 tabindex="-1">{t('wiz.title')}</h2>
          <p class="muted">{t('wiz.intro')}</p>
          <ul class="start-list">{f.start.items.map((it, i) => <li><span class="icircle"><Icon name={['calendar', 'euro', 'doc'][i] ?? 'check'} size={15} /></span><span>{it}</span></li>)}</ul>
          <p class="start-meta">{f.start.meta.map((m) => <span>{m}</span>)}</p>
          <button class="btn btn-primary wide" type="button" data-next style="view-transition-name: primary-cta">{t('wiz.go')}</button>
          <p class="muted small existing">{f.start.existing} <a href={lp('/app/login')}>{t('login')}</a></p>
        </div>
        <div class="start-visual" aria-hidden="true"><PhotoStage src="/img/photos/cine-berlin-dusk.jpg" pos="50% 60%" ratio="5 / 5.6" fill><AppDuo locale={locale} front="setup" back="money" bare /></PhotoStage></div>
      </div>
    </section>

    <section class="card white step" data-step="purpose" hidden>
      <h2 tabindex="-1">{t('wiz.q1')}</h2>
      {purposes.map(([group, opts]) => <>
        <div class="group caps">{group}</div>
        {opts.map((o) => <button type="button" class="opt" data-next data-answer="purpose" data-value={String(optIndex++)}>{o}</button>)}
      </>)}
    </section>

    <section class="card white step" data-step="from" hidden>
      <h2 tabindex="-1">{f.qFrom}</h2>
      <button type="button" class="opt" data-next data-answer="from" data-value="islamabad">{f.fromIslamabad}</button>
      <button type="button" class="opt" data-next data-answer="from" data-value="karachi">{f.fromKarachi}</button>
      <p class="muted small">{f.fromNote}</p>
    </section>

    <!-- Alter als Formular: Enter im Feld geht weiter wie der Knopf (M11) -->
    <section class="card white step" data-step="age" hidden>
      <h2 tabindex="-1">{t('wiz.q2')}</h2>
      <form data-step-form novalidate>
        <label class="field"><span>{t('wiz.age')}</span><input type="number" placeholder="23" min="14" max="99" data-answer="age" inputmode="numeric" /></label>
        <p class="muted small">{t('wiz.ageNote')}</p>
        <button class="btn btn-primary wide" type="submit" data-next>{t('continue')}</button>
      </form>
    </section>

    <!-- Ankunft (M11): zwei Semesterkarten (visuell zuerst, order: -1), darunter aufklappbar "anderer Monat" mit dem Monatsfeld,
         das im DOM das erste [data-answer=arrival] bleibt (QA-Skripte setzen es direkt). Der Weiter-Knopf ist das einzige [data-goto]. -->
    <section class="card white step" data-step="arrival" hidden>
      <h2 tabindex="-1">{t('wiz.q3')}</h2>
      <div class="arrival-pick">
        <details class="other-month">
          <summary>{f.arrivalPick.other}</summary>
          <label class="field"><span>{t('wiz.arrival')}</span><input type="month" data-answer="arrival" /></label>
        </details>
        <div class="semesters">{semesters.map((s) => <button type="button" class="opt semester" data-pick-arrival={s.ym} data-sem={s.k}><b>{s.name}</b><small>{s.when}</small></button>)}</div>
      </div>
      <p class="muted small">{t('wiz.arrivalNote')}</p>
      <!-- Die Finanzierungsfrage gilt nur fuer Studentenvisa; Jobsuche und Chancenkarte springen zum E-Mail-Schritt (Skript) -->
      <button class="btn btn-primary wide" type="button" data-goto="funding">{t('continue')}</button>
    </section>

    <section class="card white step" data-step="funding" hidden>
      <h2 tabindex="-1">{t('wiz.fundQ')}</h2>
      <button type="button" class="opt" data-goto="email" data-answer="funding" data-value="have">{t('wiz.fundHave')}</button>
      <button type="button" class="opt" data-goto="loan" data-answer="funding" data-value="need">{t('wiz.fundNeed')}</button>
    </section>

    <section class="card white step" data-step="loan" hidden>
      <p class="kicker">{t('wiz.loanNote')}</p>
      <h2 tabindex="-1">{t('wiz.loanTitle')}</h2>
      <p class="muted">{t('wiz.loanText')}</p>
      <p class="chipline"><span class="chip-note"><Icon name="shield" size={13} />{f.noCheck}</span></p>
      <p class="q">{f.loanQ}</p>
      <button type="button" class="opt" data-goto="email" data-answer="guarantor" data-value="yes">{f.loanYes}</button>
      <button type="button" class="opt" data-goto="email" data-answer="guarantor" data-value="no">{f.loanNo}</button>
    </section>

    <section class="card white step" data-step="email" hidden>
      <h2 tabindex="-1">{f.qEmail}</h2>
      <form data-step-form novalidate>
        <label class="field"><span>{t('email')}</span><input type="email" placeholder="you@example.com" data-answer="email" autocomplete="email" /></label>
        <p class="muted small">{f.emailNote}</p>
        <button class="btn btn-primary wide" type="submit" data-goto="result">{t('continue')}</button>
        <button class="btn btn-link" type="button" data-goto="result">{f.skip}</button>
      </form>
    </section>

    <section class="step result wide-card" data-step="result" hidden>
      <div class="card white head">
        <div class="head-text">
          <p class="kicker">{f.resultKicker}</p>
          <h2 tabindex="-1">{f.resultTitle}</h2>
          <p class="muted">{f.resultLead}</p>
        </div>
        <dl class="glance">
          <div><dt>{f.glance.total}</dt><dd data-out="glanceTotal"></dd></div>
          <div><dt>{f.glance.appt}</dt><dd data-out="glanceAppt"></dd></div>
          <div><dt>{f.glance.docs}</dt><dd data-out="glanceDocs"></dd></div>
        </dl>
      </div>

      <div class="grid3">
        <div class="card white" style="view-transition-name: plan-card">
          <span class="icircle sm"><Icon name="spark" size={18} /></span><p class="caps lbl">{f.setupLabel}</p>
          <h3>{f.setupComplete}</h3>
          <p class="price">{money(PRICE.monthly, locale)} {t('perMonth')} · {f.noSetupFee}</p>
          <p class="muted" data-out="setupWhy">{f.setupWhy.study}</p>
        </div>
        <div class="card white">
          <span class="icircle sm"><Icon name="shield" size={18} /></span><p class="caps lbl">{f.insuranceTitle}</p>
          <h3 data-out="planName">{f.statutory}</h3>
          <p class="price"><span data-out="premium">{money(PREMIUM.statutoryStudent, locale)}</span> <small>{t('perMonth')}</small></p>
          <p class="muted">{f.premiumNote} {f.billedOnArrival}</p>
        </div>
        <div class="card white fund">
          <span class="icircle sm"><Icon name="bank" size={18} /></span><p class="caps lbl">{f.fundLabel}</p>
          <h3 data-out="fundTitle">{f.fund.have.title}</h3>
          <p class="muted" data-out="fundText">{f.fund.have.text}</p>
          <p class="muted small" data-out="fundNote" hidden></p>
        </div>
      </div>

      <div class="card white money">
        <h3>{f.moneyTitle}</h3>
        <label class="field rate"><span>{f.rate}</span><input type="number" data-rate value={PKR_PER_EUR_EXAMPLE} min="100" max="1000" step="0.5" inputmode="decimal" /><small>{f.rateNote}</small></label>
        <!-- Hauptbuch (base.css .ledger, M11): Euro rechts, Rupien darunter; die Ausgaben laufen bei echter Kurseingabe weich um -->
        <dl class="ledger sums">
          <div><dt>{f.deposit}<small data-out="depositSub">{f.depositSub}</small></dt><dd><span data-out="depositEur">{money(PRICE.deposit, locale)}</span><small class="pkr" data-out="depositPkr"></small></dd></div>
          <div><dt>{f.transferFee}</dt><dd><span data-out="feeEur"></span><small class="pkr" data-out="feePkr"></small></dd></div>
          <div class="total"><dt>{f.totalEur}<small>{f.totalPkr}</small></dt><dd><span data-out="totalEur"></span><small class="pkr" data-out="totalPkr"></small></dd></div>
        </dl>
        <p class="muted small" set:html={markPh(f.feeNote)} />
      </div>

      <div class="grid2">
        <div class="card white">
          <h3>{f.timelineTitle}</h3>
          <p class="muted small">{f.timelineLead}</p>
          <ol class="tl" data-out="timeline"></ol>
          <!-- Kalenderdatei (.ics) fuer den Botschaftstermin, im Browser erzeugt (Jan 20.09., Accessoire) -->
          <p><button class="btn btn-link" type="button" data-ics>{f.calendar}</button></p>
        </div>
        <div class="card white">
          <h3>{f.docsTitle}</h3>
          <p class="muted small">{f.docsLead}</p>
          <div class="dbar" aria-hidden="true"><i data-out="docsBar"></i></div>
          <p class="muted small" data-out="docsProgress"></p>
          <!-- Haken-Kreise wie .checklist li.ok (base.css); das native Kaestchen bleibt im Label, nur unsichtbar -->
          <ul class="docs checklist" data-out="docs"></ul>
          <h4 class="caps lbl emb">{f.embassyTitle}</h4>
          <p class="muted small" data-out="embassy"></p>
          <p class="muted small" set:html={markPh(f.embassyWait)} />
          <p><a class="btn btn-link" href={lp('/embassy-checklist')}>{f.embassyTitle}</a></p>
        </div>
      </div>

      <p class="muted small disclaimer">{f.disclaimer}</p>
      <!-- Auf dem Telefon klebt die Aktionskarte unten, der Primaerknopf bleibt im Bild (M11) -->
      <div class="card actions section--dark on-dark">
        <h3>{f.actions}</h3>
        <div class="btns">
          <a class="btn btn-outline" data-whatsapp href="https://wa.me/?text=" target="_blank" rel="noopener"><Icon name="chat" size={18} /> {f.whatsapp}</a>
          <button class="btn btn-outline" type="button" data-print><Icon name="doc" size={18} /> {f.print}</button>
          <button class="btn btn-primary" type="button" data-goto="account">{f.createAccount}</button>
        </div>
      </div>
    </section>

    <!-- Registrierung (Jan 20.09.: "der ist noch bisschen lieblos"): Zusammenfassung des Plans, Felder mit Pruefung, Passwort
         mit Anzeige und Staerke, Einwilligung mit Links, dann ein Erfolgsschritt mit den naechsten drei Schritten. -->
    <section class="card white step acct" data-step="account" hidden>
      <p class="kicker">{f.acct.kicker}</p>
      <h2 tabindex="-1">{f.acct.title}</h2>
      <p class="muted">{f.acct.lead}</p>
      <p class="chipline"><span class="chip-note"><Icon name="check" size={13} />{f.acct.free}</span></p>
      <div class="summary">
        <span class="caps lbl">{f.acct.summary}</span>
        <ul>
          <li><span class="icircle xs"><Icon name="spark" size={13} /></span><span data-out="sumSetup">{f.setupComplete}</span></li>
          <li><span class="icircle xs"><Icon name="bank" size={13} /></span><span data-out="sumFund">{f.fund.have.title}</span></li>
          <li><span class="icircle xs"><Icon name="calendar" size={13} /></span><span data-out="sumAppt">{f.calendarTitle}</span></li>
        </ul>
      </div>
      <form data-acct novalidate>
        <label class="field" data-field="email"><span>{t('email')}</span><input type="email" placeholder="you@example.com" data-mirror="email" autocomplete="email" required /><small class="err" data-err="email" hidden>{f.acct.emailErr}</small></label>
        <label class="field" data-field="pw"><span>{t('password')}</span>
          <span class="pw-wrap"><input type="password" placeholder="••••••••" autocomplete="new-password" minlength="8" required data-pw /><button type="button" class="pw-toggle" data-pw-toggle aria-pressed="false" data-show={f.acct.show} data-hide={f.acct.hide}>{f.acct.show}</button></span>
          <span class="meter" aria-hidden="true"><i data-meter></i></span>
          <small class="muted hint" data-pw-hint data-labels={f.acct.strength.join('|')}>{f.acct.pwHint}</small>
          <small class="err" data-err="pw" hidden>{f.acct.pwErr}</small>
        </label>
        <button class="btn btn-primary wide" type="submit">{t('createAccount')}</button>
        <p class="muted small consent" set:html={consentHtml} />
      </form>
      <div class="or">{t('or')}</div>
      <button class="btn btn-outline wide" type="button" data-social="google"><Mark name="google" label={false} size={18} />{t('withGoogle')}</button>
      <button class="btn btn-outline wide" type="button" data-social="apple"><Mark name="apple" label={false} size={18} />{t('withApple')}</button>
      <p class="muted small">{t('alreadyRegistered')} <a href={lp('/app/login')}>{t('login')}</a></p>
    </section>

    <section class="card white step done" data-step="done" hidden>
      <svg class="ck" viewBox="0 0 64 64" width="76" height="76" aria-hidden="true"><circle cx="32" cy="32" r="30" class="ck-c" /><path d="M20 33l8 8 16-17" class="ck-p" /></svg>
      <h2 tabindex="-1">{f.acct.doneTitle}</h2>
      <p class="muted">{f.acct.doneText}</p>
      <ol class="next">{f.acct.doneSteps.map((st) => <li><span class="n" aria-hidden="true" /><span>{st}</span></li>)}</ol>
      <a class="btn btn-primary wide" href={lp('/app/dashboard')}>{f.acct.goPortal}</a>
    </section>

    <!-- Plan-Karte ab 1000 px (M12): rechts neben den Fragen, klebend; Zeilen fuellen sich mit jeder Antwort -->
    <aside class="plan-card" data-plan-card hidden aria-label={f.acct.summary}>
      <p class="caps lbl">{f.acct.summary}</p>
      <dl class="ledger plan-rows">
        <div><dt>{f.setupLabel}</dt><dd>{f.setupComplete} · {money(PRICE.monthly, locale)} {t('perMonth')}</dd></div>
        <div data-plan-row><dt>{f.insuranceTitle}</dt><dd class="none" data-plan="insurance">–</dd></div>
        <div data-plan-row><dt>{f.fundLabel}</dt><dd class="none" data-plan="financing">–</dd></div>
        <div data-plan-row><dt>{f.deposit}</dt><dd class="none" data-plan="deposit">–</dd></div>
        <div data-plan-row><dt>{f.glance.appt}</dt><dd class="none" data-plan="appointment">–</dd></div>
        <div data-plan-row><dt>{f.docsTitle}</dt><dd class="none" data-plan="docs">–</dd></div>
      </dl>
      <p class="see" data-plan-see hidden><button type="button" class="btn btn-link">{f.skip}</button></p>
    </aside>

    <p class="privacy"><Icon name="lock" size={14} />{f.privacy}</p>
  </div>
  <script is:inline type="application/json" data-funnel set:html={JSON.stringify(data)} />
  <script>
    import { tweenText } from '../scripts/tween';
    // Zustand des Funnels und Berechnung des Plans. Nichts verlaesst den Browser; alle Ausgaben ueber textContent.
    type Answers = { purpose?: number; from?: 'islamabad' | 'karachi'; age?: number; arrival?: string; funding?: 'have' | 'need'; guarantor?: 'yes' | 'no'; email?: string; months?: number };
    type Step = { key: string; label: string; weeks: number };
    type Fund = { title: string; text: string };
    type Model = { group: 'study' | 'work'; statutory: boolean; premium: number; fund: Fund; dep: number; fee: number; total: number; arrival: Date; appointmentDate: Date | null; docsCount: number; setupWhy: string; embassy: string; loan: boolean; rate: number; planName: string; docs: string[]; tl: { key: string; label: string; date: Date; late: boolean }[] };
    type RenderOpts = { tween?: boolean; first?: boolean; quiet?: boolean };

    const initWizard = () => {
      const root = document.querySelector<HTMLElement>('[data-wizard]:not([data-bound])'); if (!root) return; root.dataset.bound = '1';
      const data = JSON.parse(document.querySelector('[data-funnel]')?.textContent || '{}');
      const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
      const ids = steps.map((s) => s.dataset.step!);
      const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
      const back = $('[data-back]'), rail = $('[data-rail]'), railProg = $('[data-rail-prog]'), count = $('[data-count]'), track = $('[data-progress]');
      const planCard = $('[data-plan-card]'), planStrip = $('[data-plan-strip]'), planSee = $('[data-plan-see]');
      const rateInput = $<HTMLInputElement>('[data-rate]'), monthInput = $<HTMLInputElement>('input[data-answer="arrival"]');
      const semesterCards = [...root.querySelectorAll<HTMLButtonElement>('[data-pick-arrival]')];
      const rtl = document.documentElement.dir === 'rtl';
      const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      let a: Answers = {}; let hist: number[] = []; let i = 0;
      const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
      const loc: string = data.locale;
      const euro = (n: number) => (loc === 'en' ? `€${Math.round(n).toLocaleString('en-US')}` : `${Math.round(n).toLocaleString('en-US')} یورو`);
      const pkr = (n: number) => `PKR ${Math.round(n).toLocaleString('en-US')}`;
      // Optionen 0 bis 6 sind Studium, 7 und 8 Chancenkarte und Jobsuche (funnel-copy GROUP_OF)
      const group = (p: number) => (p < 7 ? 'study' : 'work');
      const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const ymd = (d: Date) => `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
      const el = (tag: string, cls: string, text: string) => { const x = document.createElement(tag); if (cls) x.className = cls; x.textContent = text; return x; };
      const rate = () => Number(rateInput.value) || data.rate;
      // Zustand: Antworten, Schritt und Verlauf in sessionStorage (ec-wiz); der Schritt zusaetzlich in der URL
      const persist = () => { try { sessionStorage.setItem('ec-wiz', JSON.stringify({ a, i, hist })); } catch {} };
      const b64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      const unb64 = (s: string) => new TextDecoder().decode(Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0)));
      // Plan in der URL (?plan=): die Antworten ohne E-Mail, damit der geteilte Link keine Adresse traegt
      const encPlan = () => { const { email: _e, ...rest } = a; return b64(JSON.stringify(rest)); };
      const decPlan = (s: string): Answers | null => { try { const p = JSON.parse(unb64(s)); return p && typeof p === 'object' ? p : null; } catch { return null; } };
      const url = (n: number) => { const id = ids[n]; return id === 'start' ? location.pathname : `?step=${id}${id === 'result' ? '&plan=' + encPlan() : ''}`; };

      // Semesterkarten mit dem echten Datum: naechster Oktober und naechster April, chronologisch
      (() => {
        const now = new Date(), y = now.getFullYear(), m = now.getMonth();
        const list = (['winter', 'summer'] as const).map((k) => { const mo = k === 'winter' ? 9 : 3; return { k, d: new Date(m < mo ? y : y + 1, mo, 1) }; }).sort((p, q) => p.d.getTime() - q.d.getTime());
        semesterCards.forEach((c, n) => { const s = list[n]; if (!s) return; c.dataset.pickArrival = `${s.d.getFullYear()}-${String(s.d.getMonth() + 1).padStart(2, '0')}`; c.dataset.sem = s.k; const [name, when] = String(data.arrivalPick[s.k]).replace('{month}', s.d.toLocaleDateString(data.monthLocale, { month: 'long' })).replace('{year}', String(s.d.getFullYear())).split(' · '); const b = c.querySelector('b'), sm = c.querySelector('small'); if (b) b.textContent = name; if (sm) sm.textContent = when ?? ''; });
      })();

      // Fragen des Zweigs: die Finanzierungsfrage nur fuer Studium, der Kreditschritt nur bei "I need financing"
      const questions = () => { const q = ['purpose', 'from', 'age', 'arrival']; if (group(a.purpose ?? 0) === 'study') { q.push('funding'); if (a.funding === 'need') q.push('loan'); } q.push('email'); return q; };
      const progress = (animate: boolean) => {
        const q = questions(); const k = q.indexOf(ids[i]); railProg.hidden = k < 0; if (k < 0) return;
        count.textContent = String(data.stepOf).replace('{a}', String(k + 1)).replace('{b}', String(q.length));
        if (track.children.length !== q.length) track.replaceChildren(...q.map(() => document.createElement('i')));
        track.setAttribute('aria-valuenow', String(k + 1)); track.setAttribute('aria-valuemax', String(q.length));
        track.classList.toggle('is-anim', animate && !reduce());
        [...track.children].forEach((seg, n) => seg.classList.toggle('on', n <= k));
      };

      // Optionen: Druck markiert sofort (Haken federt ein), gewaehlte Antworten bleiben beim Zurueckgehen markiert (.is-on)
      const press = (o: HTMLElement) => { o.closest('[data-step]')?.querySelectorAll('.opt.is-pressed').forEach((x) => x.classList.remove('is-pressed')); o.classList.add('is-pressed'); };
      const syncOptions = (s: HTMLElement) => s.querySelectorAll<HTMLElement>('.opt').forEach((o) => {
        o.classList.remove('is-pressed');
        const key = o.dataset.answer as keyof Answers | undefined;
        const cur = key ? a[key] : o.dataset.pickArrival !== undefined ? a.arrival : undefined;
        const on = cur !== undefined && String(cur) === (o.dataset.value ?? o.dataset.pickArrival);
        o.classList.toggle('is-on', on); o.setAttribute('aria-pressed', String(on));
      });
      const syncArrival = () => { const det = root.querySelector<HTMLDetailsElement>('.other-month'); if (det && a.arrival && !semesterCards.some((c) => c.dataset.pickArrival === a.arrival)) det.open = true; };

      // Blattwechsel (M11): hidden wird SOFORT umgeschaltet (QA-Skripte und Fokus sehen das neue Blatt sofort); das alte Blatt
      // bleibt als Overlay an Ort und Stelle stehen, bis der Uebergang laeuft (nach dem Druck 160 ms), dann View Transition
      // (Alt ausblenden, Neu von der Seite herein) oder, ohne Unterstuetzung, WAAPI. Reduzierte Bewegung: harter Schnitt.
      type VT = { ready?: Promise<void>; updateCallbackDone?: Promise<void>; finished?: Promise<void>; skipTransition: () => void };
      const dsvt = (document as Document & { startViewTransition?: (cb: () => void) => VT }).startViewTransition;
      let pending = 0, seq = 0, leaving: HTMLElement | null = null, active: VT | null = null;
      // Chrome trifft waehrend einer View Transition nur noch <html> (pointer-events hilft nicht): ein Klick in dieser Zeit
      // bricht den Uebergang ab und geht an das Element unter dem Zeiger, damit schnelle Tipper (und die QA-Skripte) nichts verlieren
      document.addEventListener('click', (e) => {
        if (!active || e.target !== document.documentElement) return;
        const tr = active; active = null; tr.skipTransition();
        const hit = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>('button, a, summary, label, input');
        if (hit) hit.click();
      }, true);
      const unleave = (s: HTMLElement | null) => { if (!s) return; s.classList.remove('is-leaving'); s.style.cssText = ''; if (leaving === s) leaving = null; };
      const swap = (from: HTMLElement | null, to: HTMLElement, dir: number, delay: number, vt: boolean) => {
        clearTimeout(pending); unleave(leaving); const my = ++seq;
        const box = from && from !== to ? { top: from.offsetTop, left: from.offsetLeft, width: from.offsetWidth } : null;
        steps.forEach((s) => { s.hidden = s !== to; s.classList.remove('is-entering'); s.removeAttribute('data-vt'); });
        if (!from || !box || dir === 0 || reduce()) { to.setAttribute('data-vt', ''); return; }
        from.classList.add('is-leaving'); from.style.cssText = `top:${box.top}px;left:${box.left}px;width:${box.width}px`; from.setAttribute('data-vt', ''); leaving = from;
        to.classList.add('is-entering');
        const x = 24 * dir * (rtl ? -1 : 1);
        const run = () => {
          if (my !== seq) return;
          document.documentElement.style.setProperty('--wiz-x', `${x}px`);
          const update = () => { unleave(from); from.removeAttribute('data-vt'); if (my !== seq) return; to.classList.remove('is-entering'); to.setAttribute('data-vt', ''); };
          if (vt && dsvt) {
            const tr = dsvt.call(document, update); active = tr;
            // abgebrochene Uebergaenge (skipTransition) lehnen ready ab; das ist erwartet und kein Fehler
            tr.ready?.catch(() => {}); tr.updateCallbackDone?.catch(() => {});
            tr.finished?.finally(() => { if (active === tr) active = null; }).catch(() => {});
            return;
          }
          update();
          from.classList.add('is-leaving'); from.style.cssText = `top:${box.top}px;left:${box.left}px;width:${box.width}px`; leaving = from;
          from.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 180, easing: 'ease-out', fill: 'both' }).onfinish = () => unleave(from);
          to.animate([{ opacity: 0, transform: `translateX(${x}px)` }, { opacity: 1, transform: 'none' }], { duration: 280, easing: 'cubic-bezier(.16, 1, .3, 1)', fill: 'both' });
        };
        if (delay) pending = window.setTimeout(run, delay); else run();
      };

      const shown = new Set<string>();
      const show = (dir: 1 | -1 | 0, delay = 0) => {
        root.dataset.dir = String(dir);
        const id = ids[i], from = steps.find((s) => !s.hidden) ?? null, to = steps[i];
        // nach oben nur, wenn der Anfang des Funnels oben aus dem Bild ist; dann laeuft der Wechsel ohne View Transition
        const above = root.getBoundingClientRect().top < 0;
        if (above) root.scrollIntoView({ block: 'start', behavior: reduce() ? 'auto' : 'smooth' });
        swap(from, to, dir, delay, !above);
        back.hidden = i === 0 || id === 'done';
        rail.hidden = id === 'start' || id === 'done';
        progress(dir === 1);
        planCard.hidden = id === 'start' || id === 'result';
        planStrip.hidden = id === 'start' || id === 'result' || id === 'done';
        planSee.hidden = !shown.has('result') || id === 'result';
        syncOptions(to);
        if (id === 'arrival') syncArrival();
        if (id === 'result') render(computeModel(a, rate()), { first: !shown.has('result') });
        shown.add(id);
        if (dir !== 0) to.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
        persist();
      };
      const go = (n: number, delay = 0) => { if (n === i || n < 0 || n >= steps.length) return; hist.push(i); i = n; show(1, delay); try { history.pushState({ i }, '', url(i)); } catch {} };
      const goId = (id: string, delay = 0) => go(ids.indexOf(id), delay);
      // Zurueck: ueber die Browser-History, wenn der aktuelle Eintrag unserer ist (dann macht popstate den Rest), sonst per Verlauf
      const stepBack = () => {
        if (!hist.length && i === 0) return;
        const own = history.state && typeof history.state.i === 'number' && history.state.i === i;
        if (own && hist.length) { history.back(); return; }
        i = hist.length ? hist.pop()! : Math.max(0, i - 1); show(-1); try { history.replaceState({ i }, '', url(i)); } catch {}
      };
      back.addEventListener('click', (e) => { e.preventDefault(); stepBack(); });
      window.addEventListener('popstate', (e) => {
        const st = e.state as { i?: unknown } | null; if (!st || typeof st.i !== 'number' || st.i === i || st.i < 0 || st.i >= steps.length) return;
        const isBack = hist.length > 0 && hist[hist.length - 1] === st.i; if (isBack) hist.pop(); else hist.push(i);
        i = st.i; show(isBack ? -1 : 1);
      });

      const read = (x: HTMLElement) => {
        const key = x.dataset.answer as keyof Answers | undefined; if (!key) return;
        const v = x.dataset.value ?? (x as HTMLInputElement).value;
        (a as Record<string, unknown>)[key] = v === '' ? undefined : key === 'purpose' || key === 'age' ? Number(v) : v;
        persist();
      };
      const readInputs = () => root.querySelectorAll<HTMLInputElement>('input[data-answer]').forEach(read);
      const refresh = () => render(computeModel(a, rate()), {});
      root.querySelectorAll<HTMLInputElement>('input[data-answer]').forEach((x) => x.addEventListener('change', () => { read(x); refresh(); }));
      // Die Finanzierungsfrage nur fuer Studentenvisa; Fachkraefte bringen den Sperrbetrag selbst mit
      const goTo = (target: string, delay = 0) => { const work = group(a.purpose ?? 0) === 'work'; if (work) { a.funding = undefined; a.guarantor = undefined; } goId(target === 'funding' && work ? 'email' : target, delay); };
      const advance = (b: HTMLElement) => {
        const isOpt = b.classList.contains('opt'); if (isOpt) press(b);
        read(b); readInputs(); refresh();
        const delay = isOpt && !reduce() ? 160 : 0;
        if (b.hasAttribute('data-next')) go(i + 1, delay); else if (b.dataset.goto) goTo(b.dataset.goto, delay);
      };
      root.querySelectorAll<HTMLElement>('.opt').forEach((o) => { o.addEventListener('pointerdown', () => press(o)); o.addEventListener('pointercancel', () => o.classList.remove('is-pressed')); });
      // Knoepfe; Submit-Knoepfe der Schrittformulare laufen ueber submit (Enter im Feld geht dann genauso weiter)
      root.querySelectorAll<HTMLElement>('[data-next], [data-goto]').forEach((b) => { if ((b as HTMLButtonElement).type === 'submit' && b.closest('form[data-step-form]')) return; b.addEventListener('click', () => advance(b)); });
      root.querySelectorAll<HTMLFormElement>('form[data-step-form]').forEach((fm) => fm.addEventListener('submit', (e) => { e.preventDefault(); const b = fm.querySelector<HTMLElement>('button[type="submit"]'); if (b) advance(b); }));
      semesterCards.forEach((c) => c.addEventListener('click', () => { monthInput.value = c.dataset.pickArrival ?? ''; monthInput.dispatchEvent(new Event('change', { bubbles: true })); press(c); readInputs(); refresh(); goTo('funding', reduce() ? 0 : 160); }));
      planSee.querySelector('button')?.addEventListener('click', () => goId('result'));
      // Kurs: nur eine echte Eingabe laesst die Summen weich umlaufen (tween.ts); Skripte sehen den Zielwert sofort
      rateInput.addEventListener('input', (e) => render(computeModel(a, rate()), { tween: e.isTrusted && !reduce() }));

      // Modell (M12): alles, was Ergebnis und Plan-Karte zeigen, aus Antworten und Kurs
      const computeModel = (ans: Answers, rate: number): Model => {
        const g = group(ans.purpose ?? 0);
        const loan = g === 'study' && ans.funding === 'need';
        // Versicherung: Studierende unter 30 gesetzlich, ab 30 der private Studententarif; Fachkraefte privat
        const age = ans.age ?? 23;
        const statutory = g === 'study' && age < 30;
        const premium = statutory ? data.premium.statutoryStudent : g === 'study' ? data.premium.privateStudent : data.premium.privateOther;
        // Finanzierung: Kredit (nur Studium), eigenes Geld mit Bonus, oder Fachkraft ohne Kredit
        const fund: Fund = loan ? data.fund.need : g === 'study' ? data.fund.have : data.fund.work;
        // Geld: Sperrbetrag je Visumtyp; beim Kredit zahlt die Partnerbank, es ist nichts zu ueberweisen
        const dep = g === 'work' ? data.depositWork : data.deposit;
        const fee = loan ? 0 : dep * data.feePct / 100;
        const total = loan ? 0 : dep + fee;
        const arrival = ans.arrival ? new Date(ans.arrival + '-01T00:00:00') : new Date(Date.now() + 120 * 864e5);
        const today = new Date();
        const tl = (data.tl as Step[]).map((st) => { const date = new Date(arrival.getTime() - st.weeks * 7 * 864e5); return { key: st.key, label: loan && st.key === 'transfer' ? data.tlLoan : st.label, date, late: date < today && st.weeks > 0 }; });
        const appt = tl.find((x) => x.key === 'appointment');
        const docs: string[] = [...data.docsCommon, ...(data.docs[g] ?? [])];
        return { group: g, statutory, premium, fund, dep, fee, total, arrival, appointmentDate: appt ? appt.date : null, docsCount: docs.length, setupWhy: data.setupWhy[g], embassy: data.embassy[ans.from ?? 'islamabad'], loan, rate, planName: statutory ? data.statutory : data.privatePlan, docs, tl };
      };

      const setText = (x: HTMLElement, s: string, tween: boolean) => { if (x.textContent === s) return; if (tween) tweenText(x, s, 550); else x.textContent = s; };
      // Werte im Ergebniskopf zaehlen beim ersten Zeigen von 0 hoch
      const countIn = (x: HTMLElement, target: string) => { if (reduce()) { x.textContent = target; return; } x.textContent = target.replace(/\d[\d.,]*/g, '0'); tweenText(x, target, 700); };
      // Plan-Zeilen (Karte und Streifen): Gedankenstrich bis zur Antwort, dann weicher Zahlenlauf und kurzes Aufleuchten der Zeile
      const plan = (k: string, v: string | null, o: RenderOpts) => root.querySelectorAll<HTMLElement>(`[data-plan="${k}"]`).forEach((s) => {
        const txt = v ?? '–'; if (s.textContent === txt) return;
        s.classList.toggle('none', v === null);
        if (v === null || o.quiet || reduce()) s.textContent = txt; else tweenText(s, txt, 550);
        if (!o.quiet) { const row = s.closest<HTMLElement>('[data-plan-row]'); if (row) { row.classList.remove('is-changed'); void row.offsetWidth; row.classList.add('is-changed'); } }
      });

      const render = (m: Model, o: RenderOpts) => {
        const tw = !!o.tween;
        out('setupWhy').textContent = m.setupWhy;
        out('planName').textContent = m.planName; out('premium').textContent = euro(m.premium);
        out('fundTitle').textContent = m.fund.title; out('fundText').textContent = m.fund.text;
        const note = out('fundNote'); note.hidden = !(m.loan && a.guarantor === 'no'); note.textContent = data.labels.guarantorNote;
        out('depositSub').textContent = m.group === 'work' ? data.labels.depositSubWork : data.labels.depositSub;
        setText(out('depositEur'), euro(m.dep), tw); setText(out('depositPkr'), m.loan ? '' : pkr(m.dep * m.rate), tw);
        setText(out('feeEur'), euro(m.fee), tw); setText(out('feePkr'), m.loan ? '' : pkr(m.fee * m.rate), tw);
        setText(out('totalEur'), euro(m.total), tw); setText(out('totalPkr'), m.loan ? data.labels.nothingToTransfer : pkr(m.total * m.rate), tw);
        // Zeitplan
        const tl = out('timeline'); tl.replaceChildren();
        for (const st of m.tl) {
          if (st.key === 'appointment') root.dataset.appt = ymd(st.date);
          const li = document.createElement('li');
          li.append(el('span', 'when', st.late ? data.today : fmt(st.date)), el('span', 'what', st.label));
          if (st.late) li.classList.add('late');
          tl.appendChild(li);
        }
        // Dokumente (Haken im Browser gespeichert); Zeile als .checklist-Kreis, das Kaestchen bleibt im Label
        const docs = out('docs'); docs.replaceChildren();
        const saved: Record<string, boolean> = (() => { try { return JSON.parse(localStorage.getItem('ec-docs') || '{}'); } catch { return {}; } })();
        const prog = () => { const n = m.docs.filter((_, k) => saved[`${m.group}-${k}`]).length; out('docsProgress').textContent = String(data.docsProgress).replace('{a}', String(n)).replace('{b}', String(m.docs.length)); out('docsBar').style.width = `${Math.round((n / Math.max(1, m.docs.length)) * 100)}%`; };
        m.docs.forEach((txt, k) => {
          const id = `${m.group}-${k}`;
          const li = document.createElement('li');
          const label = document.createElement('label');
          const box = document.createElement('input'); box.type = 'checkbox'; box.checked = !!saved[id];
          li.classList.toggle('ok', box.checked);
          box.addEventListener('change', () => { saved[id] = box.checked; li.classList.toggle('ok', box.checked); try { localStorage.setItem('ec-docs', JSON.stringify(saved)); } catch {} prog(); });
          label.append(box, el('span', '', txt));
          li.appendChild(label);
          docs.appendChild(li);
        });
        prog();
        out('embassy').textContent = m.embassy;
        // WhatsApp-Text; letzte Zeile ist der Link auf dieses Ergebnis (?step=result&plan=...)
        const planUrl = location.origin + location.pathname + '?step=result&plan=' + encPlan();
        const lines = [data.whatsappText, `${data.setupName} · ${euro(data.monthly)} ${data.perMonth} · ${data.labels.noSetupFee}`, `${m.fund.title}: ${m.fund.text}`, `${data.labels.totalEur}: ${euro(m.total)}${m.loan ? '' : ` (${pkr(m.total * m.rate)} @ ${m.rate})`}`, ...m.tl.map((st) => `${fmt(st.date)}: ${st.label}`), planUrl];
        root.querySelector<HTMLAnchorElement>('[data-whatsapp]')!.href = 'https://wa.me/?text=' + encodeURIComponent(lines.join('\n'));
        const mirror = root.querySelector<HTMLInputElement>('[data-mirror="email"]'); if (mirror && a.email) mirror.value = a.email;
        // Zusammenfassung im Registrierungsschritt
        out('sumSetup').textContent = `${data.setupName} · ${euro(data.monthly)} ${data.perMonth}`;
        out('sumFund').textContent = m.fund.title;
        out('sumAppt').textContent = m.appointmentDate ? `${data.calendarTitle}: ${fmt(m.appointmentDate)}` : data.calendarTitle;
        // Kopf des Ergebnisses
        const glanceTotal = m.loan ? data.labels.nothingToTransfer.split(':')[0] : euro(m.total);
        if (o.first) { countIn(out('glanceTotal'), glanceTotal); countIn(out('glanceDocs'), String(m.docsCount)); }
        else { setText(out('glanceTotal'), glanceTotal, tw); out('glanceDocs').textContent = String(m.docsCount); }
        out('glanceAppt').textContent = m.appointmentDate ? fmt(m.appointmentDate) : '';
        // Lebender Plan (M12): Zeilen erst, wenn die Antwort da ist
        const known = a.purpose !== undefined;
        plan('insurance', known ? `${m.planName} · ${euro(m.premium)}` : null, o);
        plan('financing', known && (m.group === 'work' || a.funding !== undefined) ? m.fund.title : null, o);
        plan('deposit', known ? euro(m.dep) : null, o);
        plan('appointment', a.arrival && m.appointmentDate ? fmt(m.appointmentDate) : null, o);
        plan('docs', known ? String(m.docsCount) : null, o);
      };

      // Registrierung: Pruefung im Browser, Passwort anzeigen, Staerke bewerten; nichts wird gesendet
      // Neues Konto: das Portal startet im Zustand "vor der Abreise" (portal-demo.ts)
      const fresh = () => { try { localStorage.setItem('ec-persona', 'applying'); } catch {} };
      const acct = root.querySelector<HTMLFormElement>('[data-acct]');
      if (acct) {
        const email = acct.querySelector<HTMLInputElement>('input[type="email"]')!, pw = acct.querySelector<HTMLInputElement>('[data-pw]')!;
        const err = (k: string, on: boolean) => { const e = acct.querySelector<HTMLElement>(`[data-err="${k}"]`); const fld = acct.querySelector<HTMLElement>(`[data-field="${k}"]`); if (e) e.hidden = !on; fld?.classList.toggle('is-invalid', on); };
        const strength = (v: string) => { let n = 0; if (v.length >= 8) n++; if (/[A-Z]/.test(v) && /[a-z]/.test(v)) n++; if (/\d/.test(v)) n++; if (/[^A-Za-z0-9]/.test(v)) n++; return v.length < 8 ? 1 : n >= 4 ? 3 : n >= 3 ? 2 : 1; };
        const meter = acct.querySelector<HTMLElement>('[data-meter]')!, hint = acct.querySelector<HTMLElement>('[data-pw-hint]')!; const labels = (hint.dataset.labels ?? '').split('|'); const hint0 = hint.textContent;
        pw.addEventListener('input', () => { const v = pw.value; const k = v ? strength(v) : 0; meter.className = k ? `w${k}` : ''; hint.textContent = k ? labels[k - 1] ?? hint0 : hint0; if (v.length >= 8) err('pw', false); });
        email.addEventListener('input', () => { if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) err('email', false); });
        const toggle = acct.querySelector<HTMLButtonElement>('[data-pw-toggle]')!;
        toggle.addEventListener('click', () => { const show = pw.type === 'password'; pw.type = show ? 'text' : 'password'; toggle.textContent = show ? toggle.dataset.hide! : toggle.dataset.show!; toggle.setAttribute('aria-pressed', String(show)); pw.focus(); });
        acct.addEventListener('submit', (e) => {
          e.preventDefault();
          const okMail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()), okPw = pw.value.length >= 8;
          err('email', !okMail); err('pw', !okPw);
          if (!okMail) { email.focus(); return; } if (!okPw) { pw.focus(); return; }
          a.email = email.value.trim(); fresh(); goId('done');
        });
        root.querySelectorAll<HTMLButtonElement>('[data-social]').forEach((b) => b.addEventListener('click', () => { fresh(); goId('done'); }));
      }
      root.querySelector<HTMLElement>('[data-print]')!.addEventListener('click', () => window.print());
      // Botschaftstermin als Kalenderdatei: ganztaegig am berechneten Tag, Beschreibung ist der Hinweis zur Mission
      root.querySelector<HTMLElement>('[data-ics]')?.addEventListener('click', () => {
        const day = root.dataset.appt; if (!day) return;
        const next = new Date(Number(day.slice(0, 4)), Number(day.slice(4, 6)) - 1, Number(day.slice(6, 8)) + 1);
        const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//EC Assets//Mockup//EN', 'BEGIN:VEVENT', `UID:ec-${day}@mockup`, `DTSTAMP:${ymd(new Date())}T090000Z`, `DTSTART;VALUE=DATE:${day}`, `DTEND;VALUE=DATE:${ymd(next)}`, `SUMMARY:${data.calendarTitle}`, `DESCRIPTION:${String(data.embassy[a.from ?? 'islamabad']).replace(/,/g, '\\,')}`, 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
        const u = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' })); const l = document.createElement('a'); l.href = u; l.download = 'visa-appointment.ics'; l.click(); setTimeout(() => URL.revokeObjectURL(u), 1000);
      });

      // Start: Zustand aus der Session nur beim Wiederaufnehmen (Reload, Zurueck, ?step=/?plan=), ein frischer Aufruf beginnt
      // vorn; dann die URL-Parameter (Planer M06: ?group=student|work&months=N&rate=R) und localStorage ec-plan (months, rate)
      const params = new URLSearchParams(location.search);
      const nav = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
      const resume = params.has('step') || params.has('plan') || nav === 'reload' || nav === 'back_forward';
