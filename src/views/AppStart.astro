      const ageIn = root.querySelector<HTMLInputElement>('input[data-answer="age"]'); if (ageIn) ageIn.value = a.age !== undefined ? String(a.age) : '';
      monthInput.value = a.arrival ?? '';
      const mailIn = root.querySelector<HTMLInputElement>('input[data-answer="email"]'); if (mailIn) mailIn.value = a.email ?? '';
      try { history.replaceState({ i }, '', url(i)); } catch {}
      render(computeModel(a, rate()), { quiet: true });
      show(0);
      steps.forEach(syncOptions);
    };
