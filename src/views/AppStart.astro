      const monthsP = Number(params.get('months') ?? saved.months); if (Number.isFinite(monthsP) && monthsP > 0) a.months = monthsP;
      const rateP = Number(params.get('rate') ?? saved.rate); if (Number.isFinite(rateP) && rateP > 0) rateInput.value = String(rateP);
      if (stepIdx >= 0) i = stepIdx; else if (groupParam !== null || purposeParam !== null) i = ids.indexOf('purpose');
