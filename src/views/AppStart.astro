  .step[data-vt] { view-transition-name: wiz-step; }
  ::view-transition { pointer-events: none; }
  ::view-transition-group(wiz-step) { animation-duration: .28s; animation-timing-function: var(--ease-out-soft); }
  ::view-transition-old(wiz-step) { animation: wizOut .18s ease-out both; }
  ::view-transition-new(wiz-step) { animation: wizIn .28s var(--ease-out-soft) both; }
  @keyframes wizOut { to { opacity: 0; transform: translateX(calc(var(--wiz-x) * -.5)); } }
  @keyframes wizIn { from { opacity: 0; transform: translateX(var(--wiz-x)); } }
</style>
<style>
