      const planParam = params.get('plan'); if (planParam) { const p = decPlan(planParam); if (p) a = { ...a, ...p }; }
      const stepIdx = params.has('step') ? ids.indexOf(params.get('step')!) : -1;
      const groupParam = params.get('group'), purposeParam = params.get('purpose');
      if (groupParam === 'student') a.purpose = 0; else if (groupParam === 'work') a.purpose = 7;
      if (purposeParam !== null && /^[0-8]$/.test(purposeParam)) a.purpose = Number(purposeParam);
      const fromP = params.get('from'); if (fromP === 'islamabad' || fromP === 'karachi') a.from = fromP;
      const ageP = params.get('age'); if (ageP && /^\d{1,2}$/.test(ageP)) a.age = Number(ageP);
      const arrP = params.get('arrival'); if (arrP && /^\d{4}-\d{2}$/.test(arrP)) a.arrival = arrP;
      const fundP = params.get('funding'); if (fundP === 'have' || fundP === 'need') a.funding = fundP;
